++	u64 bar = c->bar_addr | GSI_RTK_PCIE_SELECT;
++	u64 msi = bar + c->tail_offset;
++	const struct reg *reg;
++	u32 queue, value;
++
++	reg = gsi_reg(gsi, EV_CH_E_CNTXT_0);
++	value = reg_encode(reg, EV_CHTYPE, GSI_CHANNEL_TYPE_RTK) |
++		reg_encode(reg, EV_ELEMENT_SIZE, GSI_RTK_ELEMENT_SIZE);
++	/* EV_INTYPE = 0: MSI straight to the RTL8125, no AP NAPI. */
++	gsi_rtk_write(gsi, EV_CH_E_CNTXT_0, ev, value);
++	gsi_rtk_write(gsi, EV_CH_E_CNTXT_1, ev, c->ring_size);
++	gsi_rtk_write(gsi, EV_CH_E_CNTXT_2, ev, lower_32_bits(c->ring_addr));
++	gsi_rtk_write(gsi, EV_CH_E_CNTXT_3, ev, upper_32_bits(c->ring_addr));
++	reg = gsi_reg(gsi, EV_CH_E_CNTXT_8);
++	value = c->toward_ipa ? 0 : reg_encode(reg, EV_MODT, 32) |
++		reg_encode(reg, EV_MODC, 128);
++	gsi_rtk_write(gsi, EV_CH_E_CNTXT_8, ev, value);
++	gsi_rtk_write(gsi, EV_CH_E_CNTXT_9, ev, 0);
++	gsi_rtk_write(gsi, EV_CH_E_CNTXT_10, ev, lower_32_bits(msi));
++	gsi_rtk_write(gsi, EV_CH_E_CNTXT_11, ev, upper_32_bits(msi));
++	gsi_rtk_write(gsi, EV_CH_E_CNTXT_12, ev, 0);
++	gsi_rtk_write(gsi, EV_CH_E_CNTXT_13, ev, 0);
++	gsi_rtk_write(gsi, EV_CH_E_SCRATCH_0, ev, 0);
++	gsi_rtk_write(gsi, EV_CH_E_SCRATCH_1, ev, 0);
++
++	reg = gsi_reg(gsi, CH_C_CNTXT_0);
++	value = reg_encode(reg, CHTYPE_PROTOCOL, GSI_CHANNEL_TYPE_RTK) |
++		reg_encode(reg, ELEMENT_SIZE, GSI_RTK_ELEMENT_SIZE);
++	if (c->toward_ipa)
++		value |= reg_bit(reg, CHTYPE_DIR);
++	gsi_rtk_write(gsi, CH_C_CNTXT_0, ch, value);
++	reg = gsi_reg(gsi, CH_C_CNTXT_1);
++	value = reg_encode(reg, CH_R_LENGTH, c->ring_size) |
++		reg_encode(reg, CH_ERINDEX, ev);
++	gsi_rtk_write(gsi, CH_C_CNTXT_1, ch, value);
++	gsi_rtk_write(gsi, CH_C_CNTXT_2, ch, lower_32_bits(c->ring_addr));
++	gsi_rtk_write(gsi, CH_C_CNTXT_3, ch, upper_32_bits(c->ring_addr));
++	reg = gsi_reg(gsi, CH_C_QOS);
++	value = reg_encode(reg, WRR_WEIGHT, 1) | reg_bit(reg, USE_DB_ENG) |
++		reg_bit(reg, DB_IN_BYTES) |
++		reg_encode(reg, PREFETCH_MODE, SMART_PREFETCH) |
++		reg_encode(reg, EMPTY_LVL_THRSHOLD, 3);
++	gsi_rtk_write(gsi, CH_C_QOS, ch, value);
++	queue = c->toward_ipa ? c->queue : (c->queue ? 18 : 16);
++	gsi_rtk_write(gsi, CH_C_SCRATCH_0, ch, lower_32_bits(bar));
++	value = upper_32_bits(bar) | (queue << 9) |
++		(ilog2(c->buffer_size) << 14) |
++		(upper_32_bits(c->buffer_addr) << 24);
++	gsi_rtk_write(gsi, CH_C_SCRATCH_1, ch, value);
++	gsi_rtk_write(gsi, CH_C_SCRATCH_2, ch, lower_32_bits(c->buffer_addr));
++	gsi_rtk_write(gsi, CH_C_SCRATCH_3, ch, 0);
++	/* No DMA starts here; endpoint/uC and NIC setup still precede START. */
++	gsi_rtk_write(gsi, EV_CH_E_DOORBELL_0, ev,
++		      lower_32_bits(c->ring_addr) + c->ring_size + 32);
++	if (!c->toward_ipa)
++		gsi_rtk_write(gsi, CH_C_CNTXT_8, ch, 0xfdb);
++}
