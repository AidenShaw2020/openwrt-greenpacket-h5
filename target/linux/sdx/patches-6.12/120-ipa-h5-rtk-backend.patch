+
+/* MSI event rings share the hardware IEOB mask with IRQ rings. Keep their
+ * bits enabled while AP NAPI temporarily masks its own completion interrupts.
+ */
+static void gsi_irq_msi_set(struct gsi *gsi, u32 event_id, bool enable)
+{
+	const struct reg *reg = gsi_reg(gsi, CNTXT_SRC_IEOB_IRQ_MSK);
+	unsigned long flags;
+	u32 mask;
+
+	spin_lock_irqsave(&gsi->ieob_lock, flags);
+	if (enable)
+		gsi->msi_enabled_bitmap |= BIT(event_id);
+	else
+		gsi->msi_enabled_bitmap &= ~BIT(event_id);
+	mask = gsi->ieob_enabled_bitmap | gsi->msi_enabled_bitmap;
+	iowrite32(mask, gsi->virt + reg_offset(reg));
+	if (mask)
+		gsi_irq_type_enable(gsi, GSI_IEOB);
+	else
+		gsi_irq_type_disable(gsi, GSI_IEOB);
+	spin_unlock_irqrestore(&gsi->ieob_lock, flags);
 }
 
