#!/bin/sh /etc/rc.common
START=96
STOP=10

stage_file=/sys/bus/platform/devices/soc:ipa-ethernet/stage
wan_param=/sys/module/h5_ipa_rtk/parameters/wan_ifname

bind_r8125() {
	local pci dev driver
	[ -e /sys/class/net/eth0/device ] || return 0
	pci="$(basename "$(readlink -f /sys/class/net/eth0/device)")"
	dev="/sys/bus/pci/devices/$pci"
	[ -e "$dev" ] || return 0
	driver=""
	if [ -L "$dev/driver" ]; then
		driver="$(basename "$(readlink -f "$dev/driver")")"
	fi
	if [ "$driver" != "r8125" ]; then
		modprobe r8125 2>/dev/null || insmod /lib/modules/$(uname -r)/r8125.ko 2>/dev/null || true
		echo r8125 > "$dev/driver_override"
		if [ -n "$driver" ] && [ -e "/sys/bus/pci/drivers/$driver/unbind" ]; then
			echo "$pci" > "/sys/bus/pci/drivers/$driver/unbind"
		fi
		echo "$pci" > /sys/bus/pci/drivers/r8125/bind
	fi
}

ensure_controller() {
	bind_r8125
	if [ ! -e "$stage_file" ]; then
		rmmod h5_ipa_rtk 2>/dev/null || true
		modprobe h5_ipa_rtk 2>/dev/null || insmod /lib/modules/$(uname -r)/h5_ipa_rtk.ko 2>/dev/null || true
	fi
}

start() {
	[ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = "greenpacket,h5-200q1" ] || return 0
	[ "$(uci -q get firewall.@defaults[0].flow_offloading_hw)" = "1" ] || return 0
	if [ -w /proc/sys/net/core/netdev_max_backlog ]; then
		echo 4096 > /proc/sys/net/core/netdev_max_backlog 2>/dev/null || true
	fi
	ensure_controller
	[ -e "$stage_file" ] || return 0
	if [ "$(ifstatus mobile 2>/dev/null | jsonfilter -e '@.up' 2>/dev/null)" = "true" ]; then
		# Pass netifd's data netdev; ModemManager may recreate its mux link.
		l3="$(ifstatus mobile 2>/dev/null | jsonfilter -e '@.l3_device' 2>/dev/null)"
		[ -n "$l3" ] && [ -w "$wan_param" ] && printf '%s' "$l3" > "$wan_param"
		if ! grep -q '^4 failed=0 ' "$stage_file" 2>/dev/null; then
			echo 0 > "$stage_file" 2>/dev/null || true
			echo 4 > "$stage_file" 2>/dev/null || true
			fw4 -q reload 2>/dev/null || true
		fi
	fi
}

stop() {
	if [ -e "$stage_file" ]; then
		echo 0 > "$stage_file" 2>/dev/null || true
	fi
}

reload() {
	start
}
