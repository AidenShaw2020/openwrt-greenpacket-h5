+			if (!ipa_qmi_rtk_eq_valid(&req->filter_spec_list[i].filter_rule))
+				return false;
+	if (req->filter_spec_ex_list_valid)
+		for (i = 0; i < req->filter_spec_ex_list_len; i++)
+			if (!ipa_qmi_rtk_eq_valid(&req->filter_spec_ex_list[i].filter_rule))
