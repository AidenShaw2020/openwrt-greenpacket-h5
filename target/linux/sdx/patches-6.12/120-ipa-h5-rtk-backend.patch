+	struct gsi_trans *trans;
+	union ipa_cmd_payload *buffer;
+	dma_addr_t address;
+	__le64 *payload;
+	u64 word;
+
+	if (!ipa || ipa->version != IPA_VERSION_5_0 || !ipa->setup_complete ||
+	    table > 3 || !IS_ALIGNED(offset, sizeof(u16)))
+		return -EINVAL;
+	trans = ipa_cmd_trans_alloc(ipa, 2);
+	if (!trans)
+		return -EBUSY;
+	ipa_cmd_register_write_add(trans, 0, 0, 0, true);
+	buffer = ipa_cmd_payload_alloc(ipa, &address);
+	payload = (void *)buffer;
+	word = (u64)table << 4 | (u64)offset << 8 | (u64)value << 40;
+	*payload = cpu_to_le64(word);
+	/* Commit CPU-written rule contents before the enable/chain update. */
+	dma_wmb();
+	gsi_trans_cmd_add(trans, payload, sizeof(*payload), address, 14);
+	gsi_trans_commit_wait(trans);
+	return 0;
+}
