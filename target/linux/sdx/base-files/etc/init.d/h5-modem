#!/bin/sh /etc/rc.common
# Start right after the LAN and asynchronously: loading the modem firmware
# from NAND takes tens of seconds and would otherwise hold back every later
# init script. Starting it before the network only delayed the LAN, because
# the firmware load competes for the same NAND and CPU.
START=22
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /bin/sh -c \
		"/usr/libexec/h5-modem-start || logger -t h5-modem 'Modem startup failed; LAN management remains available'"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
