#!/bin/sh
[ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = greenpacket,h5-200q1 ] || exit 0
[ -x /usr/bin/mmcli ] || exit 0
if ! uci -q get network.mobile >/dev/null; then
	uci -q batch <<'EOF'
set network.mobile=interface
set network.mobile.proto='modemmanager'
set network.mobile.device='qcom-soc'
set network.mobile.iptype='ipv4v6'
set network.mobile.auto='1'
set network.mobile.force_connection='0'
commit network
EOF
fi
# Keep the radio registered across interface restarts and bearer drops. The
# default disable/enable cycle costs a re-registration and, with the extra
# ModemManager work, CPU time on this single core. Unset only: an explicit
# choice, including one made in LuCI, is preserved.
if uci -q get network.mobile >/dev/null &&
   [ -z "$(uci -q get network.mobile.disable_modem)" ]; then
	uci set network.mobile.disable_modem='0'
	uci commit network
fi
# Standard WAN firewall policy also applies to the cellular bearer.
for zone in $(uci show firewall | sed -n 's/^\(firewall\.[^=]*\)=zone$/\1/p'); do
	[ "$(uci -q get "$zone.name")" = wan ] || continue
	case " $(uci -q get "$zone.network") " in
		*' mobile '*) ;;
		*) uci add_list "$zone.network=mobile"; uci commit firewall ;;
	esac
done
if [ -z "$(uci -q get firewall.@defaults[0].flow_offloading)" ]; then
	uci set firewall.@defaults[0].flow_offloading='1'
	uci set firewall.@defaults[0].flow_offloading_hw='1'
	uci commit firewall
fi
exit 0
