+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _GSI_RTK_H_
+#define _GSI_RTK_H_
+
+#include <linux/types.h>
+
+struct gsi;
+
+/* IPA-side IOVAs, not PCI DMA addresses.  The caller owns all mappings. */
+struct gsi_rtk_config {
+	u64 ring_addr;
+	u64 buffer_addr;
+	u64 bar_addr;
+	u32 ring_size;
+	u32 buffer_size;
+	u32 bar_size;
