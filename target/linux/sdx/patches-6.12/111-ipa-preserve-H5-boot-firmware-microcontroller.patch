--- a/drivers/net/ipa/ipa_uc.c
+++ b/drivers/net/ipa/ipa_uc.c
@@ -1,3 +1,4 @@
+#include <linux/of.h>
 // SPDX-License-Identifier: GPL-2.0
 
 /* Copyright (c) 2012-2018, The Linux Foundation. All rights reserved.
@@ -188,6 +189,21 @@
 	ipa->uc_loaded = false;
 	ipa_interrupt_enable(ipa, IPA_IRQ_UC_0);
 	ipa_interrupt_enable(ipa, IPA_IRQ_UC_1);
+	if (of_machine_is_compatible("greenpacket,h5-200q1")) {
+		struct ipa_uc_mem_area *shared = ipa_uc_shared(ipa);
+		u8 response = READ_ONCE(shared->response);
+		u16 version = le16_to_cpu(READ_ONCE(shared->interface_version));
+
+		/* Preserve the uC loaded by this board's boot firmware. A completed
+		 * command and matching ABI distinguish it from uninitialized SRAM.
+		 */
+		if (version == 0x1f &&
+		    (response == IPA_UC_RESPONSE_INIT_COMPLETED ||
+		     response == IPA_UC_RESPONSE_CMD_COMPLETED)) {
+			ipa->uc_loaded = true;
+			ipa_power_retention(ipa, true);
+		}
+	}
 }
 
