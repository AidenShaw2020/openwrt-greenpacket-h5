++	/* BAM locking infrastructure */
++	phys_addr_t lock_scratchpad_addr;
++	u32 lock_write_mask;
++	enum dma_transfer_direction direction;
++	bool bam_locked;
+ };
+ 
+ static inline struct bam_chan *to_bam_chan(struct dma_chan *common)
+@@ -586,6 +601,7 @@
