#!/bin/sh

stage_file=/sys/bus/platform/devices/soc:ipa-ethernet/stage
[ "$INTERFACE" = "mobile" ] || exit 0

case "$ACTION" in
ifup|ifupdate)
	if [ "$(uci -q get firewall.@defaults[0].flow_offloading_hw)" = "1" ]; then
		/etc/init.d/h5-ipa-offload start
		logger -t h5-ipa-offload "Activated IPA hardware flowtable offload on $INTERFACE ($ACTION)"
	fi
	;;
ifdown)
	# Nothing to do: ifdown arrives when netifd starts tearing down, while the
	# data netdev still forwards at full rate. The controller stops the offload
	# itself (stage 2, rings kept) when that netdev actually goes away, and
	# ifup restarts it if the WAN address has changed.
	;;
esac
