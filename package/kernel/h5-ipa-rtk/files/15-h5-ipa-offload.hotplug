#!/bin/sh

stage_file=/sys/bus/platform/devices/soc:ipa-ethernet/stage
[ "$INTERFACE" = "mobile" ] || exit 0

case "$ACTION" in
ifup|ifupdate)
	if [ "$(uci -q get firewall.@defaults[0].flow_offloading_hw)" = "1" ]; then
		/etc/init.d/h5-ipa-offload start
		logger -t h5-ipa-offload "Activated IPA hardware flowtable offload on $INTERFACE ($ACTION)"
	fi
	;;
ifdown)
	if [ -e "$stage_file" ]; then
		# Stage 2 keeps the NIC rings; stage 0 would reset the LAN link.
		echo 2 > "$stage_file" 2>/dev/null || echo 0 > "$stage_file" 2>/dev/null || true
		logger -t h5-ipa-offload "Stopped IPA hardware flowtable offload on $INTERFACE ($ACTION)"
	fi
	;;
esac
