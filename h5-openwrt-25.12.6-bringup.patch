diff --git a/target/linux/sdx/patches-6.12/118-mtd-qcom-fix-last-codeword-read-location.patch b/target/linux/sdx/patches-6.12/118-mtd-qcom-fix-last-codeword-read-location.patch
new file mode 100644
index 00000000..e79b1b3b
--- /dev/null
+++ b/target/linux/sdx/patches-6.12/118-mtd-qcom-fix-last-codeword-read-location.patch
@@ -0,0 +1,35 @@
+From: Gabor Juhos <j4g8y7@gmail.com>
+Subject: [PATCH] mtd: rawnand: qcom: fix read location register usage in config_nand_cw_read()
+
+On QPIC v2 the last codeword uses its own read-location registers.
+The v6.14 cleanup backported by OpenWrt selects the last-codeword values
+but writes them to the ordinary register bank. On H5 the modem changes
+the shared last-codeword registers at startup, exposing stale page tails.
+
+Backport the upstream fix without changing BAM completion or locking.
+Link: https://lore.kernel.org/r/20260928-qcom_nandc-config_nand_cw_read-fix-v1-1-98edccaaea0f@gmail.com
+Fixes: 8c52932da5e6 ("mtd: rawnand: qcom: cleanup qcom_nandc driver")
+Signed-off-by: Gabor Juhos <j4g8y7@gmail.com>
+---
+--- a/drivers/mtd/nand/raw/qcom_nandc.c
++++ b/drivers/mtd/nand/raw/qcom_nandc.c
+@@ -328,14 +328,16 @@ config_nand_cw_read(struct nand_chip *chip, bool use_ecc, int cw)
+ {
+ 	struct qcom_nand_controller *nandc = get_qcom_nand_controller(chip);
+ 	struct nand_ecc_ctrl *ecc = &chip->ecc;
+-
+ 	__le32 *reg = &nandc->regs->read_location0;
++	int reg_base = NAND_READ_LOCATION_0;
+ 
+-	if (nandc->props->qpic_version2 && qcom_nandc_is_last_cw(ecc, cw))
