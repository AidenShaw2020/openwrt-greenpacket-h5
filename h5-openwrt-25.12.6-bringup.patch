diff --git a/package/network/services/tqftpserv/files/tqftpserv.init b/package/network/services/tqftpserv/files/tqftpserv.init
new file mode 100755
index 00000000..c1eba0d3
--- /dev/null
+++ b/package/network/services/tqftpserv/files/tqftpserv.init
@@ -0,0 +1,24 @@
+#!/bin/sh /etc/rc.common
+START=75
+STOP=15
+USE_PROCD=1
+
+start_service() {
+	local version
+	version="$(uci -q get tqftpserv.main.service_version)"
+	case "$version" in
+		''|*[!0-9]*) version=1 ;;
+	esac
+	[ "$version" -ge 1 ] && [ "$version" -le 255 ] || version=1
+	mkdir -p /var/lib/tqftpserv
+	chown nobody:nogroup /var/lib/tqftpserv
+	chmod 700 /var/lib/tqftpserv
+	procd_open_instance
+	procd_set_param command /usr/sbin/tqftpserv -v "$version"
+	procd_set_param user nobody
+	procd_set_param group nogroup
+	procd_set_param respawn 3600 5 5
+	procd_set_param stdout 1
+	procd_set_param stderr 1
+	procd_close_instance
+}
diff --git a/package/network/services/tqftpserv/patches/010-select-service-version.patch b/package/network/services/tqftpserv/patches/010-select-service-version.patch
new file mode 100644
index 00000000..358c5f1c
--- /dev/null
+++ b/package/network/services/tqftpserv/patches/010-select-service-version.patch
@@ -0,0 +1,55 @@
+Subject: [PATCH] tqftpserv: allow selecting the QRTR service version
+
+Quectel RG520N OpenCPU firmware on GreenPacket H5 requests TFTP service
+4096 version 3. Without that registration no modem_pr files are fetched,
+band capabilities remain empty and DMS ONLINE fails with DeviceNotReady.
+Keep upstream version 1 as the default for other platforms.
+
+--- a/tqftpserv.c
++++ b/tqftpserv.c
+@@ -916,13 +916,16 @@
+ {
+ 	extern const char *__progname;
+ 
+-	fprintf(stderr, "Usage: %s [-d] [-h]\n", __progname);
++	fprintf(stderr, "Usage: %s [-d] [-h] [-v version]\n", __progname);
+ 	fprintf(stderr, " -d\tPrint detailed debug information\n");
+ 	fprintf(stderr, " -h\tPrint this usage info\n");
++	fprintf(stderr, " -v\tQRTR service version (1-255, default 1)\n");
+ }
+ 
+ int main(int argc, char **argv)
+ {
++	unsigned long service_version = 1;
++	char *end;
+ 	struct tftp_client *client;
+ 	struct tftp_client *next;
+ 	struct sockaddr_qrtr sq;
+@@ -937,8 +940,17 @@
+ 	int ret;
+ 	int fd;
+ 
+-	while ((opt = getopt(argc, argv, "dh")) != -1) {
++	while ((opt = getopt(argc, argv, "dhv:")) != -1) {
+ 		switch (opt) {
++		case 'v':
++			errno = 0;
++			service_version = strtoul(optarg, &end, 10);
++			if (errno || end == optarg || *end ||
++			    service_version < 1 || service_version > 255) {
++				fprintf(stderr, "Invalid QRTR service version\n");
++				return 1;
++			}
++			break;
+ 		case 'd':
+ 			tftp_debug = true;
+ 			break;
+@@ -962,7 +974,7 @@
+ 		exit(1);
+ 	}
+ 
+-	ret = qrtr_publish(fd, 4096, 1, 0);
++	ret = qrtr_publish(fd, 4096, service_version, 0);
+ 	if (ret < 0) {
+ 		fprintf(stderr, "failed to publish service registry service\n");
+ 		exit(1);
