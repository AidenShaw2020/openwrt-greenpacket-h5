+int ipa_rtk_test_rx_pause(struct ipa *ipa)
+{
+	struct device *dev;
+	struct ipa_rtk_controller *c;
+	int ret = -ENODEV;
+	dev = bus_find_device_by_name(&platform_bus_type, NULL, "soc:ipa-ethernet");
+	if (!dev)
+		return ret;
+	device_lock(dev);
+	c = dev_get_drvdata(dev);
+	if (!c || c->ipa != ipa)
+		goto unlock;
+	mutex_lock(&c->lock);
+	rtnl_lock();
+	if (c->failed)
+		ret = -ESHUTDOWN;
+	else if (c->stage < 2)
+		ret = -EAGAIN;
+	else if (c->stage == 2)
+		ret = 0;
+	else {
+		ret = rtl8125_rss_reset(c->netdev);
+		if (!ret)
+			c->stage = 2;
+	}
+	rtnl_unlock();
+	mutex_unlock(&c->lock);
+unlock:
+	device_unlock(dev);
+	put_device(dev);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(ipa_rtk_test_rx_pause);
