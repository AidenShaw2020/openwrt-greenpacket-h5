+	ipa_cmd_register_write_add(trans, 0, 0, 0, true);
+	ipa_cmd_dma_shared_mem_add(trans, pdn->offset, sizeof(struct ipa_rtk_pdn),
+				   pdn_record, true);
+	buffer = ipa_cmd_payload_alloc(ipa, &address);
+	payload = (void *)buffer;
+	memset(payload, 0, sizeof(*payload));
+	payload->base = cpu_to_le64(layout->base);
+	payload->expansion = cpu_to_le64(layout->expansion);
+	payload->index = cpu_to_le64(layout->index);
+	payload->index_expansion = cpu_to_le64(layout->index_expansion);
+	/* Address-type bits4..7 = 0 select system memory for all four tables. */
+	flags = (u64)layout->base_mask << 8;
+	flags |= (u64)layout->expansion_count << 20;
+	flags |= (u64)pdn->offset << 32;
+	payload->flags = cpu_to_le64(flags);
+	/* Publish coherent NAT/index records before hardware can follow them. */
+	dma_wmb();
+	gsi_trans_cmd_add(trans, payload, sizeof(*payload), address, 5);
+	gsi_trans_commit_wait(trans);
+	return 0;
+}
