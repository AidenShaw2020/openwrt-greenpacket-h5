++/*
++ * RTL8125 external rings on SDX65 IPA v5.0.  The protocol and scratch format
++ * follow Qualcomm dataipa ipa_eth_i.c / gsi_rtk_channel_scratch.  The H5 stock
++ * ipa3_ep_mapping selects channels 18 (producer) and 21 (consumer).
++ * Included in gsi.c to reuse its serialized hardware command implementation.
