diff --git a/package/network/config/netifd/patches/010-device-recognize-existing-kernel-interfaces.patch b/package/network/config/netifd/patches/010-device-recognize-existing-kernel-interfaces.patch
new file mode 100644
--- /dev/null
+++ b/package/network/config/netifd/patches/010-device-recognize-existing-kernel-interfaces.patch
@@ -0,0 +1,41 @@
+From 01c4149b4c71c6badced01d534b1af3570e29f61 Mon Sep 17 00:00:00 2001
+From: ghoker143 <ghoker51@protonmail.com>
+Date: Sun, 22 Mar 2026 12:43:47 +0800
+Subject: [PATCH] device: skip VLAN chain lookup for existing kernel interfaces
+
+Signed-off-by: ghoker143 <ghoker51@protonmail.com>
+---
+ device.c | 13 +++++++++++--
+ 1 file changed, 11 insertions(+), 2 deletions(-)
+
+diff --git a/device.c b/device.c
+index 301be31..a8c654f 100644
+--- a/device.c
++++ b/device.c
+@@ -14,6 +14,7 @@
+ #include <string.h>
+ #include <stdlib.h>
+ #include <stdio.h>
++#include <net/if.h>
+ #include <assert.h>
+ 
+ #include <sys/types.h>
+@@ -893,8 +894,16 @@ __device_get(const char *name, int create, bool check_vlan)
+ 
+ 	dev = avl_find_element(&devices, name, dev, avl);
+ 
+-	if (!dev && check_vlan && strchr(name, '.'))
+-		return get_vlan_device_chain(name, create);
++	if (!dev && check_vlan && strchr(name, '.')) {
++		/*
++		 * Only treat dotted names as VLAN-style if the full name does
++		 * NOT already exist as a real kernel netdev.  Externally managed
++		 * interfaces (e.g. ModemManager QMI mux links: qmapmux0.0) are
++		 * valid kernel devices whose names happen to contain a dot.
++		 */
++		if (!if_nametoindex(name))
++			return get_vlan_device_chain(name, create);
++	}
+ 
+ 	if (name[0] == '@')
+ 		return device_alias_get(name + 1);
diff --git a/package/network/services/tqftpserv/files/tqftpserv.init b/package/network/services/tqftpserv/files/tqftpserv.init
new file mode 100755
--- /dev/null
+++ b/package/network/services/tqftpserv/files/tqftpserv.init
@@ -0,0 +1,24 @@
+#!/bin/sh /etc/rc.common
+START=75
+STOP=15
+USE_PROCD=1
+
+start_service() {
+	local version
+	version="$(uci -q get tqftpserv.main.service_version)"
+	case "$version" in
+		''|*[!0-9]*) version=1 ;;
+	esac
+	[ "$version" -ge 1 ] && [ "$version" -le 255 ] || version=1
+	mkdir -p /var/lib/tqftpserv
+	chown nobody:nogroup /var/lib/tqftpserv
+	chmod 700 /var/lib/tqftpserv
+	procd_open_instance
+	procd_set_param command /usr/sbin/tqftpserv -v "$version"
+	procd_set_param user nobody
+	procd_set_param group nogroup
+	procd_set_param respawn 3600 5 5
+	procd_set_param stdout 1
+	procd_set_param stderr 1
+	procd_close_instance
+}
diff --git a/package/network/services/tqftpserv/Makefile b/package/network/services/tqftpserv/Makefile
new file mode 100644
--- /dev/null
+++ b/package/network/services/tqftpserv/Makefile
@@ -0,0 +1,68 @@
+# SPDX-License-Identifier: GPL-2.0-only
+include $(TOPDIR)/rules.mk
+
+PKG_NAME:=tqftpserv
+PKG_VERSION:=1.3
+PKG_RELEASE:=2
+PKG_LICENSE:=BSD-3-Clause
+PKG_LICENSE_FILES:=LICENSE qrtr/LICENSE
+PKG_BUILD_DIR:=$(BUILD_DIR)/$(PKG_NAME)-$(PKG_VERSION)
+
+include $(INCLUDE_DIR)/package.mk
+
+define Download/tqftpserv-source
+  FILE:=tqftpserv-1.3.tar.gz
+  URL:=https://codeload.github.com/linux-msm/tqftpserv/tar.gz/refs/tags
+  URL_FILE:=v1.3
+  HASH:=87a3845e8f47b42f31d8aaad04c5e0707e391b3954d096aeff6f0a03467dc33f
+endef
+$(eval $(call Download,tqftpserv-source))
+
+define Download/tqftpserv-qrtr
+  FILE:=qrtr-1.2.tar.gz
+  URL:=https://codeload.github.com/linux-msm/qrtr/tar.gz/refs/tags
+  URL_FILE:=v1.2
+  HASH:=7a82bf80246fe71287b13c66c0466208822e8337fcd4aaf302eee6c5fcb48a52
+endef
+$(eval $(call Download,tqftpserv-qrtr))
+
+$(STAMP_PREPARED): $(DL_DIR)/tqftpserv-1.3.tar.gz $(DL_DIR)/qrtr-1.2.tar.gz
+
+define Package/tqftpserv
+  SECTION:=net
+  CATEGORY:=Network
+  TITLE:=Qualcomm QRTR firmware file service
+  DEPENDS:=+kmod-qrtr +libpthread
+  URL:=https://github.com/linux-msm/tqftpserv
+endef
+
+define Package/tqftpserv/description
+ Upstream TFTP service over QRTR for Qualcomm remote processors. Firmware
+ is read from /lib/firmware; writable service files stay in RAM under /var.
+ No proprietary firmware is included.
+endef
+
+define Build/Prepare
+	$(INSTALL_DIR) $(PKG_BUILD_DIR)/qrtr
+	$(TAR) -C $(PKG_BUILD_DIR) --strip-components=1 -xzf $(DL_DIR)/tqftpserv-1.3.tar.gz
+	$(TAR) -C $(PKG_BUILD_DIR)/qrtr --strip-components=1 -xzf $(DL_DIR)/qrtr-1.2.tar.gz
+	$(Build/Patch)
+endef
+
+define Build/Compile
+	$(TARGET_CC) $(TARGET_CPPFLAGS) $(TARGET_CFLAGS) -D_GNU_SOURCE \
+		-ffunction-sections -fdata-sections -Wl,--gc-sections \
+		-I$(PKG_BUILD_DIR)/qrtr/include -I$(PKG_BUILD_DIR) \
+		$(PKG_BUILD_DIR)/tqftpserv.c $(PKG_BUILD_DIR)/translate.c \
+		$(PKG_BUILD_DIR)/qrtr/lib/qrtr.c $(PKG_BUILD_DIR)/qrtr/lib/qmi.c \
+		$(PKG_BUILD_DIR)/qrtr/lib/logging.c $(TARGET_LDFLAGS) \
+		-o $(PKG_BUILD_DIR)/tqftpserv
+endef
+
+define Package/tqftpserv/install
+	$(INSTALL_DIR) $(1)/usr/sbin $(1)/etc/init.d
+	$(INSTALL_BIN) $(PKG_BUILD_DIR)/tqftpserv $(1)/usr/sbin/tqftpserv
+	$(INSTALL_BIN) ./files/tqftpserv.init $(1)/etc/init.d/tqftpserv
+endef
+
+$(eval $(call BuildPackage,tqftpserv))
diff --git a/package/network/services/tqftpserv/patches/010-select-service-version.patch b/package/network/services/tqftpserv/patches/010-select-service-version.patch
new file mode 100644
--- /dev/null
+++ b/package/network/services/tqftpserv/patches/010-select-service-version.patch
@@ -0,0 +1,55 @@
+Subject: [PATCH] tqftpserv: allow selecting the QRTR service version
+
+Quectel RG520N OpenCPU firmware on GreenPacket H5 requests TFTP service
+4096 version 3. Without that registration no modem_pr files are fetched,
+band capabilities remain empty and DMS ONLINE fails with DeviceNotReady.
+Keep upstream version 1 as the default for other platforms.
+
+--- a/tqftpserv.c
++++ b/tqftpserv.c
+@@ -916,13 +916,16 @@
+ {
+ 	extern const char *__progname;
+ 
+-	fprintf(stderr, "Usage: %s [-d] [-h]\n", __progname);
++	fprintf(stderr, "Usage: %s [-d] [-h] [-v version]\n", __progname);
+ 	fprintf(stderr, " -d\tPrint detailed debug information\n");
+ 	fprintf(stderr, " -h\tPrint this usage info\n");
++	fprintf(stderr, " -v\tQRTR service version (1-255, default 1)\n");
+ }
+ 
+ int main(int argc, char **argv)
+ {
++	unsigned long service_version = 1;
++	char *end;
+ 	struct tftp_client *client;
+ 	struct tftp_client *next;
+ 	struct sockaddr_qrtr sq;
+@@ -937,8 +940,17 @@
+ 	int ret;
+ 	int fd;
+ 
+-	while ((opt = getopt(argc, argv, "dh")) != -1) {
++	while ((opt = getopt(argc, argv, "dhv:")) != -1) {
+ 		switch (opt) {
++		case 'v':
++			errno = 0;
++			service_version = strtoul(optarg, &end, 10);
++			if (errno || end == optarg || *end ||
++			    service_version < 1 || service_version > 255) {
++				fprintf(stderr, "Invalid QRTR service version\n");
++				return 1;
++			}
++			break;
+ 		case 'd':
+ 			tftp_debug = true;
+ 			break;
