+static int ipa_table_rtk_acquire_mode(struct ipa *ipa, bool filter, bool hashed,
+				    bool ipv6, u32 id, bool modem,
+				    struct ipa_rtk_table *table)
+{
+	const struct ipa_mem *mem;
+	struct ipa_rtk_table *owner;
+	__le64 original;
+	u32 offset;
+
+	if (!ipa || !table || table->ipa || ipa->version != IPA_VERSION_5_0 ||
+	    !ipa->setup_complete || !of_machine_is_compatible("greenpacket,h5-200q1"))
+		return -EINVAL;
+	if (filter) {
+		if ((id != 8 && !(modem && id == 12 && !hashed && !ipv6)) ||
+		    !(ipa->filtered & BIT_ULL(id)))
+			return -EINVAL;
+		offset = (1 + hweight64(ipa->filtered & (BIT_ULL(id) - 1))) * 8;
+	} else {
+		if (id < ipa->modem_route_count || id >= ipa->route_count)
+			return -EINVAL;
+		offset = id * 8;
+	}
+	mem = ipa_table_mem(ipa, filter, hashed, ipv6);
+	if (!mem || offset + 8 > mem->size)
+		return -ERANGE;
+	offset += mem->offset;
+	mutex_lock(&ipa_rtk_table_lock);
+	list_for_each_entry(owner, &ipa_rtk_table_owners, node)
+		if (owner->ipa == ipa && owner->offset == offset) {
+			mutex_unlock(&ipa_rtk_table_lock);
+			return -EBUSY;
+		}
+	memcpy_fromio(&original, ipa->mem_virt + ipa->mem_offset + offset, sizeof(original));
+	table->ipa = ipa;
+	table->offset = offset;
+	table->original_pointer = le64_to_cpu(original);
+	table->installed = false;
+	table->installed_pointer = 0;
+	table->base_offset = mem->offset;
+	table->modem = modem;
+	list_add_tail(&table->node, &ipa_rtk_table_owners);
+	mutex_unlock(&ipa_rtk_table_lock);
+	return 0;
+}
