+	if (!ipa || ipa->version != IPA_VERSION_5_0 || !ipa->setup_complete ||
+	    !ipa->rtk_endpoints || !frame || !IS_ALIGNED(frame, 8) ||
+	    length < ETH_ZLEN || length > 2048)
+		return -EINVAL;
+	trans = ipa_cmd_trans_alloc(ipa, 2);
+	if (!trans)
+		return -EBUSY;
+	ipa_cmd_ip_packet_init_add(trans, 26);
+	/* DMA_NONE command transactions use only the supplied DMA address and
+	 * length, not a page mapping or a pool buffer ownership transfer.
+	 */
+	gsi_trans_cmd_add(trans, NULL, length, frame, IPA_CMD_NONE);
+	dma_wmb();
+	gsi_trans_commit_wait(trans);
+	return 0;
+}
