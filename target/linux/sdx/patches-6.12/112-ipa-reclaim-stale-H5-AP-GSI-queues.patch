+/* The H5 RAM handoff leaves AP queues from the previous kernel allocated.
+ * Quiesce only the AP execution environment before allocating Linux rings.
+ * Modem-owned channels and execution environments are not modified.
+ */
+static int gsi_h5_reclaim_ap(struct gsi *gsi)
+{
+	u32 i, state;
+	int retries;
+
+	if (!of_machine_is_compatible("greenpacket,h5-200q1"))
+		return 0;
+	for (i = 0; i < gsi->channel_count; i++) {
+		struct gsi_channel *channel = &gsi->channel[i];
+		struct gsi *saved = channel->gsi;
+
+		channel->gsi = gsi;
+		state = gsi_channel_state(channel);
+		for (retries = 0; retries < 5 &&
+		     (state == GSI_CHANNEL_STATE_STARTED ||
+		      state == GSI_CHANNEL_STATE_STOP_IN_PROC); retries++) {
+			gsi_channel_stop_command(channel);
+			msleep(20);
+			state = gsi_channel_state(channel);
+		}
+		if (state == GSI_CHANNEL_STATE_STOPPED || state == GSI_CHANNEL_STATE_ERROR)
+			gsi_channel_reset_command(channel);
+		if (gsi_channel_state(channel) == GSI_CHANNEL_STATE_ALLOCATED)
+			gsi_channel_de_alloc_command(gsi, i);
+		state = gsi_channel_state(channel);
+		channel->gsi = saved;
+		if (state != GSI_CHANNEL_STATE_NOT_ALLOCATED)
+			return -EBUSY;
+	}
+	for (i = 0; i < gsi->evt_ring_count; i++) {
+		state = gsi_evt_ring_state(gsi, i);
+		if (state == GSI_EVT_RING_STATE_ERROR)
+			gsi_evt_ring_reset_command(gsi, i);
+		if (gsi_evt_ring_state(gsi, i) == GSI_EVT_RING_STATE_ALLOCATED)
+			gsi_evt_ring_de_alloc_command(gsi, i);
+		if (gsi_evt_ring_state(gsi, i) != GSI_EVT_RING_STATE_NOT_ALLOCATED)
+			return -EBUSY;
+	}
+	return 0;
+}
