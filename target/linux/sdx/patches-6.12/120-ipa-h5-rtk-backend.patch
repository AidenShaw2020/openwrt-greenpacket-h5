+	if (!ipa || !layout || ipa->version != IPA_VERSION_5_0 || !ipa->setup_complete)
+		return -EINVAL;
+	if (!is_power_of_2((u32)layout->base_mask + 1) || !layout->base_mask ||
+	    layout->base_mask > 4095 || layout->expansion_count > 1023 ||
+	    !IS_ALIGNED(layout->base, 8) || !IS_ALIGNED(layout->expansion, 8) ||
+	    !IS_ALIGNED(layout->index, 8) || !IS_ALIGNED(layout->index_expansion, 8) ||
+	    !IS_ALIGNED(pdn_record, 8))
+		return -EINVAL;
