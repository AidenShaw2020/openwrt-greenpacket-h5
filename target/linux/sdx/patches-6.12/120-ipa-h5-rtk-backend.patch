+			  u32 id, struct ipa_rtk_table *table)
+{
+	return ipa_table_rtk_acquire_mode(ipa, filter, false, ipv6, id, false, table);
+}
+EXPORT_SYMBOL_GPL(ipa_table_rtk_acquire);
+
+int ipa_table_rtk_acquire_hashed(struct ipa *ipa, bool filter, bool ipv6,
+				 u32 id, struct ipa_rtk_table *table)
+{
+	return ipa_table_rtk_acquire_mode(ipa, filter, true, ipv6, id, false, table);
+}
+EXPORT_SYMBOL_GPL(ipa_table_rtk_acquire_hashed);
+
+int ipa_table_rtk_acquire_downlink(struct ipa *ipa, struct ipa_rtk_table *table)
+{
+	return ipa_table_rtk_acquire_mode(ipa, true, false, false, 12, true, table);
+}
+EXPORT_SYMBOL_GPL(ipa_table_rtk_acquire_downlink);
+
+int ipa_table_rtk_copy_local(struct ipa_rtk_table *table, void *buffer, size_t capacity)
+{
+	struct ipa *ipa;
+	u64 pointer, relative;
+	u32 offset, cursor = 0;
+	int ret = -EINVAL;
+	if (!table || !buffer || capacity < 8 || capacity > 65536)
+		return ret;
+	mutex_lock(&ipa_rtk_table_lock);
+	ipa = table->ipa;
+	if (!ipa || table->installed)
+		goto unlock;
+	pointer = ipa_rtk_table_pointer(table);
+	if (pointer != table->original_pointer) { ret = -ESTALE; goto unlock; }
+	if (!(pointer & 1) || (pointer & 126)) { ret = -EOPNOTSUPP; goto unlock; }
+	relative = (pointer & ~127ULL) >> 4;
+	if (relative > ipa->mem_size || table->base_offset > ipa->mem_size - relative) {
+		ret = -ERANGE;
+		goto unlock;
+	}
+	offset = table->base_offset + relative;
+	while (cursor + 8 <= capacity) {
+		__le64 word;
+		u64 header;
+		u32 length;
+		if (ipa->mem_offset + offset + cursor + 8 > ipa->mem_size) {
+			ret = -ERANGE;
+			goto unlock;
+		}
+		memcpy_fromio(&word, ipa->mem_virt + ipa->mem_offset + offset + cursor, 8);
+		header = le64_to_cpu(word);
+		length = ipa_rtk_rule_size(header);
+		if (length > capacity - cursor ||
+		    ipa->mem_offset + offset + cursor + length > ipa->mem_size) {
+			ret = -ENOSPC;
+			goto unlock;
+		}
+		memcpy_fromio(buffer + cursor,
+			      ipa->mem_virt + ipa->mem_offset + offset + cursor, length);
+		cursor += length;
+		if (!header) {
+			ret = ipa_rtk_table_pointer(table) == pointer ? cursor : -ESTALE;
+			goto unlock;
+		}
+	}
+	ret = -ENOSPC;
+unlock:
+	mutex_unlock(&ipa_rtk_table_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(ipa_table_rtk_copy_local);
+
+int ipa_table_rtk_replace(struct ipa_rtk_table *table, dma_addr_t rule_address)
+{
+	int ret;
+
+	if (!table || !rule_address || !IS_ALIGNED(rule_address, 128))
+		return -EINVAL;
+	mutex_lock(&ipa_rtk_table_lock);
+	if (!table->ipa) {
+		ret = -EINVAL;
+	} else if (table->modem && ipa_rtk_table_pointer(table) !=
+		   (table->installed ? table->installed_pointer : table->original_pointer)) {
+		ret = -ESTALE;
+	} else {
+		ret = ipa_rtk_table_write(table, rule_address);
+	}
+	if (!ret) {
+		table->installed = true;
+		table->installed_pointer = rule_address;
+	}
+	mutex_unlock(&ipa_rtk_table_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(ipa_table_rtk_replace);
+
+int ipa_table_rtk_release(struct ipa_rtk_table *table)
+{
+	int ret = 0;
+
+	if (!table)
+		return -EINVAL;
+	mutex_lock(&ipa_rtk_table_lock);
+	if (table->ipa) {
+		if (table->installed) {
+			if (table->modem && ipa_rtk_table_pointer(table) != table->installed_pointer)
+				ret = ipa_rtk_table_drain(table->ipa);
+			else
+				ret = ipa_rtk_table_write(table, table->original_pointer);
+		}
+		if (!ret) {
+			list_del(&table->node);
+			memset(table, 0, sizeof(*table));
+		}
+	}
+	mutex_unlock(&ipa_rtk_table_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(ipa_table_rtk_release);
+
+static int ipa_rtk_header_write(struct ipa_rtk_header *header, const u8 data[16])
+{
+	struct ipa *ipa = header->ipa;
+	struct gsi_trans *trans;
+	dma_addr_t address;
+	u8 *buffer;
+
+	buffer = dma_alloc_coherent(ipa->dev, 16, &address, GFP_KERNEL);
+	if (!buffer)
+		return -ENOMEM;
+	memcpy(buffer, data, 16);
+	trans = ipa_cmd_trans_alloc(ipa, 2);
+	if (!trans) {
+		dma_free_coherent(ipa->dev, 16, buffer, address);
+		return -EBUSY;
+	}
+	ipa_cmd_register_write_add(trans, 0, 0, 0, true);
+	ipa_cmd_dma_shared_mem_add(trans, header->offset, 16, address, true);
+	dma_wmb();
+	gsi_trans_commit_wait(trans);
+	dma_free_coherent(ipa->dev, 16, buffer, address);
+	return 0;
+}
+
+int ipa_header_rtk_acquire(struct ipa *ipa, const u8 ethernet[14],
+			   struct ipa_rtk_header *header)
+{
+	const struct ipa_mem *ap, *modem;
+	struct ipa_rtk_header *owner;
+	u32 slot, offset;
+	u8 data[16] = {};
+	bool occupied;
+	int ret = -ENOSPC;
+
+	if (!ipa || !ethernet || !header || header->ipa ||
+	    ipa->version != IPA_VERSION_5_0 || !ipa->setup_complete ||
+	    !of_machine_is_compatible("greenpacket,h5-200q1"))
+		return -EINVAL;
+	ap = ipa_mem_find(ipa, IPA_MEM_AP_HEADER);
+	modem = ipa_mem_find(ipa, IPA_MEM_MODEM_HEADER);
+	if (!ap || !modem || ap->offset < modem->offset || ap->size < 32)
+		return -ENODEV;
+	mutex_lock(&ipa_rtk_table_lock);
+	/* Keep the first slot reserved for any default/empty header. */
+	for (slot = 16; slot + 16 <= ap->size; slot += 16) {
+		offset = ap->offset + slot;
+		occupied = false;
+		list_for_each_entry(owner, &ipa_rtk_header_owners, node)
+			if (owner->ipa == ipa && owner->offset == offset) {
+				occupied = true;
+				break;
+			}
+		if (!occupied)
+			break;
+	}
+	if (slot + 16 > ap->size)
+		goto out;
+	if ((offset - modem->offset) % 4 || (offset - modem->offset) / 4 > 511) {
+		ret = -ERANGE;
+		goto out;
+	}
+	header->ipa = ipa;
+	header->offset = offset;
+	header->route_offset = offset - modem->offset;
+	memcpy_fromio(header->original, ipa->mem_virt + ipa->mem_offset + offset, 16);
+	list_add_tail(&header->node, &ipa_rtk_header_owners);
+	memcpy(data, ethernet, 14);
+	ret = ipa_rtk_header_write(header, data);
+	if (ret) {
+		list_del(&header->node);
+		memset(header, 0, sizeof(*header));
+	}
+out:
+	mutex_unlock(&ipa_rtk_table_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(ipa_header_rtk_acquire);
+
+/* Caller removes every route referencing this slot and drains its pipeline
+ * before releasing. A failed restoration keeps the handle reserved.
+ */
+int ipa_header_rtk_release(struct ipa_rtk_header *header)
+{
+	int ret = 0;
+	if (!header)
+		return -EINVAL;
+	mutex_lock(&ipa_rtk_table_lock);
+	if (header->ipa) {
+		ret = ipa_rtk_header_write(header, header->original);
+		if (!ret) {
+			list_del(&header->node);
+			memset(header, 0, sizeof(*header));
+		}
+	}
+	mutex_unlock(&ipa_rtk_table_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(ipa_header_rtk_release);
