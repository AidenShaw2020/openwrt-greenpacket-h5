+#!/bin/sh
+# Runs again after config-preserving sysupgrade: never weaken existing settings.
+case "$(cat /tmp/sysinfo/board_name 2>/dev/null)" in
+	greenpacket,h5-200q1) ;;
+	*) exit 0 ;;
+esac
+uci set system.@system[0].ttylogin='1'
+uci commit system
+set_default() {
+	[ -n "$(uci -q get "$1")" ] || uci set "$1=$2"
+}
+set_default dropbear.@dropbear[0].PasswordAuth on
+set_default dropbear.@dropbear[0].RootPasswordAuth on
+set_default uhttpd.main.redirect_https 0
+uci commit dropbear
+uci commit uhttpd
+exit 0
diff --git a/target/linux/sdx/base-files/etc/uci-defaults/91-h5-mobile b/target/linux/sdx/base-files/etc/uci-defaults/91-h5-mobile
new file mode 100755
index 00000000..61eae235
--- /dev/null
+++ b/target/linux/sdx/base-files/etc/uci-defaults/91-h5-mobile
@@ -0,0 +1,28 @@
+#!/bin/sh
+[ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = greenpacket,h5-200q1 ] || exit 0
+[ -x /usr/bin/mmcli ] || exit 0
+if ! uci -q get network.mobile >/dev/null; then
+	uci -q batch <<'EOF'
+set network.mobile=interface
+set network.mobile.proto='modemmanager'
+set network.mobile.device='qcom-soc'
+set network.mobile.iptype='ipv4v6'
+set network.mobile.auto='1'
+set network.mobile.force_connection='0'
+commit network
+EOF
+fi
+# Standard WAN firewall policy also applies to the cellular bearer.
+for zone in $(uci show firewall | sed -n 's/^\(firewall\.[^=]*\)=zone$/\1/p'); do
+	[ "$(uci -q get "$zone.name")" = wan ] || continue
+	case " $(uci -q get "$zone.network") " in
+		*' mobile '*) ;;
+		*) uci add_list "$zone.network=mobile"; uci commit firewall ;;
+	esac
+done
+if [ -z "$(uci -q get firewall.@defaults[0].flow_offloading)" ]; then
+	uci set firewall.@defaults[0].flow_offloading='1'
+	uci set firewall.@defaults[0].flow_offloading_hw='1'
+	uci commit firewall
+fi
+exit 0
diff --git a/target/linux/sdx/base-files/lib/upgrade/platform.sh b/target/linux/sdx/base-files/lib/upgrade/platform.sh
new file mode 100644
index 00000000..ff7f944d
--- /dev/null
+++ b/target/linux/sdx/base-files/lib/upgrade/platform.sh
@@ -0,0 +1,52 @@
+REQUIRE_IMAGE_METADATA=1
+CI_KERNPART=boot
+CI_UBIPART=system
+CI_ROOTPART=rootfs
+# platform_check_image is also called after stage2 pivots away from squashfs.
+# Its exact compatible check needs this BusyBox applet in the RAM filesystem.
+RAMFS_COPY_BIN="${RAMFS_COPY_BIN:-} /usr/bin/tr"
+
+platform_check_image() {
+	case "$(board_name)" in
+	greenpacket,h5-200q1)
+		if ! tr '\000' '\n' </proc/device-tree/compatible |
+			grep -qx 'greenpacket,h5-200q1-openwrt'; then
+			echo "Use the H5 CPE initramfs installer; this profile is read-only."
+			return 1
+		fi
+		for idx in 27 31; do
+			flags="$(cat /sys/class/mtd/mtd$idx/flags)"
+			[ $((flags & 1024)) -ne 0 ] || return 1
+		done
+		nand_do_platform_check "$(board_name)" "$1"
+		;;
+	*)
+		echo "Unsupported board"
+		return 1
+		;;
+	esac
+}
+
+platform_do_upgrade() {
+	case "$(board_name)" in
+	greenpacket,h5-200q1)
+		platform_check_image "$1" || return 1
+		stage=/sys/bus/platform/devices/soc:ipa-ethernet/stage
+		if [ -f "$stage" ]; then
+			echo 0 >"$stage" 2>/dev/null || true
+		fi
+		# procd stops userspace before this RAM-stage hook. Stop MPSS too,
+		# before erasing system, so it cannot access shared NAND during it.
+		state=/sys/class/remoteproc/remoteproc0/state
+		if [ -f "$state" ]; then
+			case "$(cat "$state")" in
+				running) echo stop >"$state" || return 1 ;;
+				offline) ;;
+				*) echo 'Modem is not in a safe state for NAND upgrade'; return 1 ;;
+			esac
+			[ "$(cat "$state")" = offline ] || return 1
+		fi
+		nand_do_upgrade "$1"
+		;;
+	esac
+}
diff --git a/target/linux/sdx/base-files/usr/libexec/h5-at-bind b/target/linux/sdx/base-files/usr/libexec/h5-at-bind
new file mode 100755
index 00000000..4c12ccdb
--- /dev/null
+++ b/target/linux/sdx/base-files/usr/libexec/h5-at-bind
@@ -0,0 +1,39 @@
+#!/bin/sh
+# Use the upstream persistent default endpoint, outside MM's WWAN probing.
+set -eu
+[ "$(cat /tmp/sysinfo/board_name)" = greenpacket,h5-200q1 ] || exit 0
+[ "$(cat /sys/class/remoteproc/remoteproc0/state)" = running ] || exit 1
+modprobe rpmsg_char
+
+# The DS channel can appear well after "running" while the boot is busy.
+for n in $(seq 1 60); do
+	count=0
+	for p in /sys/bus/rpmsg/devices/*; do
+		[ -f "$p/name" ] || continue
+		[ "$(cat "$p/name")" = DS ] || continue
+		count=$((count + 1))
+		ds="$p"
+	done
+	[ "$count" = 1 ] && break
+	[ "$count" = 0 ] || exit 1
+	sleep 1
+done
+[ "$count" = 1 ] || exit 1
+if [ -e "$ds/driver" ]; then
+	[ "$(basename "$(readlink "$ds/driver")")" = rpmsg_chrdev ] || exit 1
+else
+	printf '%s\n' rpmsg_chrdev >"$ds/driver_override"
+	printf '%s\n' "${ds##*/}" >/sys/bus/rpmsg/drivers/rpmsg_chrdev/bind
+fi
+for n in $(seq 1 10); do
+	for p in /sys/class/rpmsg/rpmsg[0-9]*; do
+		[ -f "$p/name" ] || continue
+		[ "$(cat "$p/name")" = DS ] || continue
+		[ -c "/dev/${p##*/}" ] || continue
+		chmod 600 "/dev/${p##*/}"
+		ln -sf "/dev/${p##*/}" /dev/h5-at
+		exit 0
+	done
+	sleep 1
+done
+exit 1
diff --git a/target/linux/sdx/base-files/usr/libexec/h5-cellular-leds b/target/linux/sdx/base-files/usr/libexec/h5-cellular-leds
new file mode 100755
index 00000000..5d716cf4
--- /dev/null
+++ b/target/linux/sdx/base-files/usr/libexec/h5-cellular-leds
@@ -0,0 +1,34 @@
+#!/bin/sh
+# Drive only the radio LEDs; modem control remains with ModemManager/netifd.
+# The LEDs are off unless the mobile interface is up. While it is, one
+# serving-cell AT query every 30 s picks 4G or 5G; mmcli would cost several
+# times more CPU per poll on this single-core CPE. A hotplug script signals
+# USR1 on mobile ifup/ifdown for an immediate update.
+set_led() {
+	local path="/sys/class/leds/h5:$1/brightness"
+	[ -w "$path" ] && echo "$2" > "$path"
+}
+trap 'set_led 4g 0; set_led 5g 0; exit 0' TERM INT
+trap 'kill "$sleeper" 2>/dev/null' USR1
+lte=0
+nr=0
+while :; do
+	if [ "$(ubus call network.interface.mobile status 2>/dev/null | jsonfilter -e '@.up')" = true ]; then
+		serving="$(/usr/libexec/h5-at serving 2>/dev/null)"
+		case "$serving" in
+			# LuCI or a cell-lock change holds the AT port; keep the LEDs.
+			*'"error":"busy"'*) ;;
+			*NR5G-SA*|*NR5G-NSA*) lte=0; nr=1 ;;
+			*LTE*) lte=1; nr=0 ;;
+			*) lte=0; nr=0 ;;
+		esac
+	else
+		lte=0
+		nr=0
+	fi
+	set_led 4g "$lte"
+	set_led 5g "$nr"
+	sleep 30 &
+	sleeper=$!
+	wait "$sleeper"
+done
diff --git a/target/linux/sdx/base-files/usr/libexec/h5-modem-start b/target/linux/sdx/base-files/usr/libexec/h5-modem-start
new file mode 100755
index 00000000..e9f7bba9
--- /dev/null
+++ b/target/linux/sdx/base-files/usr/libexec/h5-modem-start
@@ -0,0 +1,72 @@
+#!/bin/sh
+# Start the upstream drivers using the existing stock read-only firmware volume.
+set -eu
+[ "$(cat /tmp/sysinfo/board_name)" = greenpacket,h5-200q1 ] || exit 0
+[ "$(uci -q get h5-modem.main.enabled)" = 1 ] || exit 0
+[ -f "/lib/modules/$(uname -r)/ipa.ko" ] || exit 0
+if [ -f /sys/class/remoteproc/remoteproc0/state ] &&
+   [ "$(cat /sys/class/remoteproc/remoteproc0/state)" = running ]; then
+	exit 0
+fi
+
+# This bring-up profile must never let UBI write to the original firmware.
+[ "$(cat /sys/class/mtd/mtd30/name)" = modem ]
+[ "$(cat /sys/class/mtd/mtd30/size)" = 120586240 ]
+flags="$(cat /sys/class/mtd/mtd30/flags)"
+[ $((flags & 0x400)) -eq 0 ]
+find_firmware_ubi() {
+	for path in /sys/class/ubi/ubi[0-9]*; do
+		[ -f "$path/mtd_num" ] || continue
+		[ "$(cat "$path/mtd_num")" = 30 ] || continue
+		basename "$path"
+		return 0
+	done
+	return 1
+}
+ubi="$(find_firmware_ubi)" || {
+	ubiattach -m 30 /dev/ubi_ctrl
+	ubi="$(find_firmware_ubi)"
+}
+[ "$(cat "/sys/class/ubi/${ubi}_0/name")" = modem ]
+block="/dev/ubiblock${ubi#ubi}_0"
+[ -b "$block" ] || ubiblock -c "/dev/${ubi}_0"
+mkdir -p /mnt/h5-stock-firmware /lib/firmware/greenpacket-h5
+grep -q ' /mnt/h5-stock-firmware ' /proc/mounts ||
+	mount -t squashfs -o ro,nodev,nosuid,noexec "$block" /mnt/h5-stock-firmware
+grep -q ' /lib/firmware/greenpacket-h5 ' /proc/mounts ||
+	mount -o bind /mnt/h5-stock-firmware/image /lib/firmware/greenpacket-h5
+printf '%s\n' '4bc2dede57fa1950e51899443c1a1683db9415aa980f09567d2a1a0881650359  /lib/firmware/greenpacket-h5/modem.mdt' |
+	sha256sum -c -
+
+# Cache runtime support files before MPSS starts. NAND/BAM hardware locking
+# also serializes shared accesses, while this cache avoids repeated flash
+# reads during modem registration. PAS loads signed segments before reset
+# is released.
+support=/tmp/h5-modem-firmware
+mkdir -p "$support"
+if ! grep -q ' /lib/firmware/greenpacket-h5/modem_pr ' /proc/mounts; then
+	cp -a /mnt/h5-stock-firmware/image/modem_pr "$support/"
+	mount -o bind "$support/modem_pr" /lib/firmware/greenpacket-h5/modem_pr
+fi
+
+modprobe smp2p
+modprobe qcom_q6v5_pas
+modprobe ipa
+[ "$(cat /sys/class/remoteproc/remoteproc0/name)" = 4080000.remoteproc ]
+echo disabled > /sys/class/remoteproc/remoteproc0/recovery
+echo disabled > /sys/class/remoteproc/remoteproc0/coredump
+# Discover remoteproc's firmware directory after PAS registration, before boot.
+/etc/init.d/tqftpserv restart
+sleep 1
+echo start > /sys/class/remoteproc/remoteproc0/state
+if [ -f "/lib/modules/$(uname -r)/rpmsg_char.ko" ]; then
+	# /etc/hotplug.d/rpmsg/20-h5-at binds the DS channel whenever glink
+	# (re)creates it; bind directly only if that has not happened in time.
+	for n in $(seq 1 60); do
+		[ -e /dev/h5-at ] && break
+		sleep 1
+	done
+	[ -e /dev/h5-at ] || /usr/libexec/h5-at-bind ||
+		logger -t h5-modem 'DS AT endpoint binding failed'
+fi
+logger -t h5-modem 'Modem started with upstream drivers and local read-only stock firmware'
