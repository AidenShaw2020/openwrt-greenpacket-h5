+{
+	struct ipa_rtk_nat_init_wire *payload;
+	union ipa_cmd_payload *buffer;
+	struct gsi_trans *trans;
+	dma_addr_t address;
+
+	if (!ipa || ipa->version != IPA_VERSION_5_0 || !ipa->setup_complete ||
+	    !ipa->zero_addr || ipa->zero_size < 32)
+		return -EINVAL;
+	trans = ipa_cmd_trans_alloc(ipa, 2);
+	if (!trans)
+		return -EBUSY;
+	ipa_cmd_register_write_add(trans, 0, 0, 0, true);
+	buffer = ipa_cmd_payload_alloc(ipa, &address);
+	payload = (void *)buffer;
+	memset(payload, 0, sizeof(*payload));
+	payload->base = cpu_to_le64(ipa->zero_addr);
+	payload->expansion = payload->base;
+	payload->index = payload->base;
+	payload->index_expansion = payload->base;
+	dma_wmb();
+	gsi_trans_cmd_add(trans, payload, sizeof(*payload), address, 5);
+	gsi_trans_commit_wait(trans);
+	return 0;
+}
