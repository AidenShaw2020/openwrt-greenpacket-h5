diff --git a/package/kernel/h5-ipa-rtk/src/ipa_rtk_dma.c b/package/kernel/h5-ipa-rtk/src/ipa_rtk_dma.c
new file mode 100644
index 00000000..def06f93
--- /dev/null
+++ b/package/kernel/h5-ipa-rtk/src/ipa_rtk_dma.c
@@ -0,0 +1,147 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/dma-mapping.h>
+#include <linux/iommu.h>
+#include <linux/log2.h>
+#include <linux/pci.h>
+#include <linux/rtnetlink.h>
+
+#include "ipa_rtk_dma.h"
+
+int ipa_rtk_dma_prepare(struct ipa_rtk_dma *dma, struct device *ap_dev,
+			struct device *eth_dev, struct net_device *netdev,
+			bool toward_ipa, unsigned int count, unsigned int buffer_size)
+{
+	struct device *nic_dev = netdev->dev.parent;
+	struct iommu_domain *nic_domain;
+	struct iommu_domain *eth_domain;
+	struct rtl8125_ring *ring;
+	struct pci_dev *pdev;
+	unsigned int offset;
+	int ret;
+
+	ASSERT_RTNL();
+	if (dma->ring || !nic_dev || !dev_is_pci(nic_dev) ||
+	    !nic_dev->driver || strcmp(nic_dev->driver->name, "r8125"))
+		return -EINVAL;
+	if (!is_power_of_2(count) || count < 64 || count > 4096 ||
+	    !is_power_of_2(buffer_size) || buffer_size < 2048 || buffer_size > PAGE_SIZE)
+		return -EINVAL;
+	nic_domain = iommu_get_domain_for_dev(nic_dev);
+	eth_domain = iommu_get_domain_for_dev(eth_dev);
+	/* No best-effort fallback to incompatible DMA address spaces. */
+	if (!nic_domain || nic_domain != eth_domain)
+		return -EXDEV;
+	pdev = to_pci_dev(nic_dev);
+	ring = rtl8125_request_ring(netdev, count, buffer_size,
+			toward_ipa ? RTL8125_CH_DIR_RX : RTL8125_CH_DIR_TX,
+			RTL8125_CONTIG_BUFS, NULL);
+	if (!ring)
+		return -ENOMEM;
+	dma->ring = ring;
+	dma->ap_dev = ap_dev;
+	dma->netdev = netdev;
+	/* Verify every data-buffer page in both hardware address spaces. */
+	for (offset = 0; offset < count * buffer_size; offset += PAGE_SIZE) {
+		dma_addr_t address = ring->bufs[0].dma_addr + offset;
+		phys_addr_t physical = iommu_iova_to_phys(nic_domain, address);
+
+		if (!physical || iommu_iova_to_phys(eth_domain, address) != physical) {
+			ret = -EXDEV;
+			goto err_release;
+		}
+	}
+	/* Both directions must use the stock 32-byte descriptor ABI. */
+	if (ring->desc_size != count * 32 || ring->enabled) {
+		ret = -EINVAL;
+		goto err_release;
+	}
+	ret = dma_get_sgtable(nic_dev, &dma->descriptors, ring->desc_addr,
+			     ring->desc_daddr, ring->desc_size);
+	if (ret)
+		goto err_release;
+	ret = dma_map_sgtable(ap_dev, &dma->descriptors, DMA_BIDIRECTIONAL, 0);
+	if (ret)
+		goto err_sg_free;
+	dma->descriptors_mapped = true;
+	if (dma->descriptors.nents != 1 ||
+	    sg_dma_len(dma->descriptors.sgl) < ring->desc_size) {
+		ret = -ERANGE;
+		goto err_unmap;
+	}
+	dma->config.ring_addr = sg_dma_address(dma->descriptors.sgl);
+	dma->config.ring_size = ring->desc_size;
+	dma->config.buffer_addr = ring->bufs[0].dma_addr;
+	dma->config.buffer_size = buffer_size;
+	dma->config.bar_addr = pci_resource_start(pdev, 2);
+	dma->config.bar_size = pci_resource_len(pdev, 2);
+	dma->config.queue = ring->queue_num;
+	dma->config.toward_ipa = toward_ipa;
+	dma->config.tail_offset = toward_ipa ? 0 : 0x2800 + 4 * ring->queue_num;
+	if (!IS_ALIGNED(dma->config.ring_addr, ring->desc_size) ||
+	    !IS_ALIGNED(dma->config.buffer_addr, buffer_size)) {
+		ret = -ERANGE;
+		goto err_unmap;
+	}
+	return 0;
+
+err_unmap:
+	dma_unmap_sgtable(ap_dev, &dma->descriptors, DMA_BIDIRECTIONAL, 0);
+	dma->descriptors_mapped = false;
+err_sg_free:
+	sg_free_table(&dma->descriptors);
+err_release:
+	rtl8125_release_ring(ring);
+	memset(dma, 0, sizeof(*dma));
+	return ret;
+}
+
+int ipa_rtk_dma_set_notification(struct ipa_rtk_dma *dma, phys_addr_t msi)
+{
+	struct device *nic_dev;
+	int ret;
+
+	ASSERT_RTNL();
+	if (!dma->ring || dma->notification_mapped || !IS_ALIGNED(msi, 4))
+		return -EINVAL;
+	nic_dev = dma->netdev->dev.parent;
+	/* MSI-X writes travel through the PCIe SMMU domain too. */
+	dma->notification = dma_map_resource(nic_dev, msi, 4, DMA_FROM_DEVICE, 0);
+	if (dma_mapping_error(nic_dev, dma->notification))
+		return -EIO;
+	dma->notification_mapped = true;
+	ret = rtl8125_request_event(dma->ring, MSIX_event_type, dma->notification, 0);
+	if (!ret) {
+		dma->event_claimed = true;
+		return 0;
+	}
+	dma_unmap_resource(nic_dev, dma->notification, 4, DMA_FROM_DEVICE, 0);
+	dma->notification_mapped = false;
+	return ret;
+}
+
+int ipa_rtk_dma_release(struct ipa_rtk_dma *dma, const struct gsi_rtk *rtk)
+{
+	struct device *nic_dev;
+
+	ASSERT_RTNL();
+	if (!rtk)
+		return -EINVAL;
+	if (rtk->gsi)
+		return -EBUSY;
+	if (!dma->ring)
+		return 0;
+	/* Refuse to free anything if the NIC is still an active DMA owner. */
+	if (WARN_ON(dma->ring->enabled || dma->ring->event.enabled))
+		return -EBUSY;
+	nic_dev = dma->netdev->dev.parent;
+	if (dma->event_claimed)
+		rtl8125_release_event(dma->ring);
+	if (dma->notification_mapped)
+		dma_unmap_resource(nic_dev, dma->notification, 4, DMA_FROM_DEVICE, 0);
+	if (dma->descriptors_mapped)
+		dma_unmap_sgtable(dma->ap_dev, &dma->descriptors, DMA_BIDIRECTIONAL, 0);
+	sg_free_table(&dma->descriptors);
+	rtl8125_release_ring(dma->ring);
+	memset(dma, 0, sizeof(*dma));
+	return 0;
+}
diff --git a/package/kernel/h5-ipa-rtk/src/ipa_rtk_dma.h b/package/kernel/h5-ipa-rtk/src/ipa_rtk_dma.h
new file mode 100644
index 00000000..7d1fff5d
--- /dev/null
+++ b/package/kernel/h5-ipa-rtk/src/ipa_rtk_dma.h
@@ -0,0 +1,36 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _IPA_RTK_DMA_H_
+#define _IPA_RTK_DMA_H_
+
+#include <linux/device.h>
+#include <linux/netdevice.h>
+#include <linux/scatterlist.h>
+#include <linux/iommu.h>
+#include "gsi_rtk.h"
+#include "r8125/r8125_lib.h"
+
+struct ipa_rtk_dma {
+	struct device *ap_dev;
+	struct net_device *netdev;
+	struct rtl8125_ring *ring;
+	struct sg_table descriptors;
+	struct gsi_rtk_config config;
+	dma_addr_t notification;
+	bool descriptors_mapped;
+	bool notification_mapped;
+	bool event_claimed;
+};
+
+/*
+ * Caller holds RTNL, device/module references and runtime power.  ETH SID
+ * 0x5e3 must share the NIC DMA domain before prepare, as in the stock DTS.
+ * No ring or event is enabled by prepare.  Release only after both DMA engines
+ * and the IPA uC have stopped; no memory is freed while GSI still owns it.
+ */
+int ipa_rtk_dma_prepare(struct ipa_rtk_dma *dma, struct device *ap_dev,
+			struct device *eth_dev, struct net_device *netdev,
+			bool toward_ipa, unsigned int count, unsigned int buffer_size);
+int ipa_rtk_dma_set_notification(struct ipa_rtk_dma *dma, phys_addr_t msi);
+int ipa_rtk_dma_release(struct ipa_rtk_dma *dma, const struct gsi_rtk *rtk);
+
+#endif
diff --git a/package/kernel/h5-ipa-rtk/src/ipa_rtk_flow.c b/package/kernel/h5-ipa-rtk/src/ipa_rtk_flow.c
new file mode 100644
index 00000000..2b3a4b15
--- /dev/null
+++ b/package/kernel/h5-ipa-rtk/src/ipa_rtk_flow.c
@@ -0,0 +1,188 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/etherdevice.h>
+#include <linux/in.h>
+#include <linux/ip.h>
+#include <linux/tc_act/tc_csum.h>
+#include <net/flow_offload.h>
+#include "ipa_rtk_flow.h"
+
+/* Native flow_action MANGLE words are byte copies, not host-order IPs.
+ * Applying them as native words also handles the two half-word MAC writes.
+ */
+static void mangle_word(void *bytes, u32 mask, u32 value)
+{
+	u32 word;
+	memcpy(&word, bytes, sizeof(word));
+	word = (word & mask) | value;
+	memcpy(bytes, &word, sizeof(word));
+}
+
+int ipa_rtk_flow_decode(const struct flow_rule *rule, struct ipa_rtk_flow *out)
+{
+	const unsigned long long required = BIT_ULL(FLOW_DISSECTOR_KEY_META) |
+		BIT_ULL(FLOW_DISSECTOR_KEY_CONTROL) | BIT_ULL(FLOW_DISSECTOR_KEY_BASIC) |
+		BIT_ULL(FLOW_DISSECTOR_KEY_IPV4_ADDRS) | BIT_ULL(FLOW_DISSECTOR_KEY_PORTS);
+	struct flow_match_meta meta;
+	struct flow_match_control control;
+	struct flow_match_basic basic;
+	struct flow_match_ipv4_addrs ipv4;
+	struct flow_match_ports ports;
+	struct flow_match_tcp tcp;
+	struct flow_dissector_key_meta meta_mask;
+	struct flow_dissector_key_control control_mask;
+	struct flow_dissector_key_basic basic_mask;
+	struct ipa_rtk_flow decoded = {};
+	const struct flow_action_entry *action;
+	__be32 addresses[2], translated[2];
+	__be16 original_ports[2], translated_ports[2];
+	u8 written[ETH_HLEN] = {};
+	unsigned int i;
+	bool redirect = false, checksum = false, source, destination;
+	bool is_tcp;
+	u32 checksum_flags;
+
+	if (!rule || !out || !rule->match.dissector)
+		return -EOPNOTSUPP;
+	if (!flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_BASIC))
+		return -EOPNOTSUPP;
+	flow_rule_match_basic(rule, &basic);
+	is_tcp = basic.key->ip_proto == IPPROTO_TCP;
+	if (rule->match.dissector->used_keys !=
+	    (required | (is_tcp ? BIT_ULL(FLOW_DISSECTOR_KEY_TCP) : 0)))
+		return -EOPNOTSUPP;
+	flow_rule_match_meta(rule, &meta);
+	flow_rule_match_control(rule, &control);
+	flow_rule_match_basic(rule, &basic);
+	flow_rule_match_ipv4_addrs(rule, &ipv4);
+	flow_rule_match_ports(rule, &ports);
+	meta_mask = *meta.mask;
+	control_mask = *control.mask;
+	basic_mask = *basic.mask;
+	if (meta_mask.ingress_ifindex != U32_MAX ||
+	    !meta.key->ingress_ifindex ||
+	    control_mask.addr_type != U16_MAX ||
+	    control.key->addr_type != FLOW_DISSECTOR_KEY_IPV4_ADDRS ||
+	    basic_mask.n_proto != (__force __be16)U16_MAX ||
+	    basic.key->n_proto != htons(ETH_P_IP) ||
+	    basic_mask.ip_proto != U8_MAX ||
+	    (!is_tcp && basic.key->ip_proto != IPPROTO_UDP) ||
+	    ipv4.mask->src != (__force __be32)U32_MAX ||
+	    ipv4.mask->dst != (__force __be32)U32_MAX ||
+	    ports.mask->src != (__force __be16)U16_MAX ||
+	    ports.mask->dst != (__force __be16)U16_MAX)
+		return -EOPNOTSUPP;
+	if (is_tcp) {
+		flow_rule_match_tcp(rule, &tcp);
+		/* Preserve native NF's FIN/RST exclusion in hardware equations.
+		 * H5 NAT redirect bit14 also redirects normal TCP data; leave it
+		 * clear and send control packets through the CPU classifier. */
+		if (tcp.key->flags || tcp.mask->flags != htons(0x0005))
+			return -EOPNOTSUPP;
+	}
+	checksum_flags = TCA_CSUM_UPDATE_FLAG_IPV4HDR |
+		(is_tcp ? TCA_CSUM_UPDATE_FLAG_TCP : TCA_CSUM_UPDATE_FLAG_UDP);
+	/* Reject extra metadata/control/basic restrictions we cannot enforce. */
+	meta_mask.ingress_ifindex = 0;
+	control_mask.addr_type = 0;
+	basic_mask.n_proto = 0;
+	basic_mask.ip_proto = 0;
+	if (memchr_inv(&meta_mask, 0, sizeof(meta_mask)) ||
+	    memchr_inv(&control_mask, 0, sizeof(control_mask)) ||
+	    memchr_inv(&basic_mask, 0, sizeof(basic_mask)))
+		return -EOPNOTSUPP;
+	addresses[0] = ipv4.key->src;
+	addresses[1] = ipv4.key->dst;
+	original_ports[0] = ports.key->src;
+	original_ports[1] = ports.key->dst;
+	memcpy(translated, addresses, sizeof(translated));
+	memcpy(translated_ports, original_ports, sizeof(translated_ports));
+	decoded.ingress_ifindex = meta.key->ingress_ifindex;
+	decoded.ethernet[12] = ETH_P_IP >> 8;
+	decoded.ethernet[13] = ETH_P_IP & 0xff;
+	flow_action_for_each(i, action, &rule->action) {
+		u32 mask, value, offset;
+		if (redirect)
+			return -EOPNOTSUPP;
+		switch (action->id) {
+		case FLOW_ACTION_MANGLE:
+			mask = action->mangle.mask;
+			value = action->mangle.val;
+			offset = action->mangle.offset;
+			if (value & mask)
+				return -EOPNOTSUPP;
+			switch (action->mangle.htype) {
+			case FLOW_ACT_MANGLE_HDR_TYPE_ETH:
+				if (offset > 8 || offset % 4)
+					return -EOPNOTSUPP;
+				mangle_word(decoded.ethernet + offset, mask, value);
+				mangle_word(written + offset, mask, ~mask);
+				break;
+			case FLOW_ACT_MANGLE_HDR_TYPE_IP4:
+				if (mask || (offset != offsetof(struct iphdr, saddr) &&
+				    offset != offsetof(struct iphdr, daddr)))
+					return -EOPNOTSUPP;
+				mangle_word(&translated[(offset - offsetof(struct iphdr, saddr)) / 4],
+					    mask, value);
+				break;
+			case FLOW_ACT_MANGLE_HDR_TYPE_UDP:
+			case FLOW_ACT_MANGLE_HDR_TYPE_TCP:
+				if (action->mangle.htype != (is_tcp ? FLOW_ACT_MANGLE_HDR_TYPE_TCP :
+							   FLOW_ACT_MANGLE_HDR_TYPE_UDP))
+					return -EOPNOTSUPP;
+				if (offset || (mask != (__force u32)htonl(0xffff) &&
+				    mask != (__force u32)htonl(0xffff0000)))
+					return -EOPNOTSUPP;
+				mangle_word(translated_ports, mask, value);
+				break;
+			default:
+				return -EOPNOTSUPP;
+			}
+			break;
+		case FLOW_ACTION_CSUM:
+			if (checksum || action->csum_flags != checksum_flags)
+				return -EOPNOTSUPP;
+			checksum = true;
+			break;
+		case FLOW_ACTION_REDIRECT:
+			if (!action->dev)
+				return -EINVAL;
+			decoded.egress_ifindex = action->dev->ifindex;
+			redirect = true;
+			break;
+		default:
+			return -EOPNOTSUPP;
+		}
+	}
+	if (!redirect || memchr_inv(written, 0xff, 12))
+		return -EOPNOTSUPP;
+	source = addresses[0] != translated[0] || original_ports[0] != translated_ports[0];
+	destination = addresses[1] != translated[1] || original_ports[1] != translated_ports[1];
+	/* A routed flow (IP passthrough) has no NAT and no checksum action. Its
+	 * direction depends on the ingress device, which only the manager knows;
+	 * report it in source form and let the manager install identity NAT.
+	 */
+	if (!source && !destination && !checksum)
+		decoded.identity = true;
+	/* One IPA NAT entry cannot express simultaneous source and destination NAT. */
+	else if (!checksum || source == destination)
+		return -EOPNOTSUPP;
+	decoded.destination = destination;
+	decoded.nat.protocol = basic.key->ip_proto;
+	if (source || decoded.identity) {
+		decoded.nat.private_ip = addresses[0];
+		decoded.nat.private_port = original_ports[0];
+		decoded.nat.public_ip = translated[0];
+		decoded.nat.public_port = translated_ports[0];
+		decoded.nat.remote_ip = addresses[1];
+		decoded.nat.remote_port = original_ports[1];
+	} else {
+		decoded.nat.private_ip = translated[1];
+		decoded.nat.private_port = translated_ports[1];
+		decoded.nat.public_ip = addresses[1];
+		decoded.nat.public_port = original_ports[1];
+		decoded.nat.remote_ip = addresses[0];
+		decoded.nat.remote_port = original_ports[0];
+	}
+	*out = decoded;
+	return 0;
+}
diff --git a/package/kernel/h5-ipa-rtk/src/ipa_rtk_flow.h b/package/kernel/h5-ipa-rtk/src/ipa_rtk_flow.h
new file mode 100644
index 00000000..9ae46e71
--- /dev/null
+++ b/package/kernel/h5-ipa-rtk/src/ipa_rtk_flow.h
@@ -0,0 +1,18 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _IPA_RTK_FLOW_H_
+#define _IPA_RTK_FLOW_H_
+#include <linux/if_ether.h>
+#include "ipa_rtk_nat_wire.h"
+
+struct flow_rule;
+struct ipa_rtk_flow {
+	struct ipa_rtk_nat_tuple nat;
+	int ingress_ifindex, egress_ifindex;
+	u8 ethernet[ETH_HLEN];
+	bool destination;
+	/* Routed without translation; nat holds the source-form tuple. */
+	bool identity;
+};
+/* Only decode; never program hardware or retain a borrowed net_device. */
+int ipa_rtk_flow_decode(const struct flow_rule *rule, struct ipa_rtk_flow *out);
+#endif
diff --git a/package/kernel/h5-ipa-rtk/src/ipa_rtk_flow_manager.c b/package/kernel/h5-ipa-rtk/src/ipa_rtk_flow_manager.c
new file mode 100644
index 00000000..32269b90
--- /dev/null
+++ b/package/kernel/h5-ipa-rtk/src/ipa_rtk_flow_manager.c
@@ -0,0 +1,434 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/in.h>
+#include <linux/jiffies.h>
+#include <linux/slab.h>
+#include <linux/bitmap.h>
+#include <linux/jhash.h>
+#include "ipa_rtk_flow_manager.h"
+
+static bool same_tuple(const struct ipa_rtk_nat_tuple *a, const struct ipa_rtk_nat_tuple *b)
+{
+	return a->private_ip == b->private_ip && a->remote_ip == b->remote_ip &&
+		a->public_ip == b->public_ip && a->private_port == b->private_port &&
+		a->remote_port == b->remote_port && a->public_port == b->public_port &&
+		a->protocol == b->protocol && a->pdn == b->pdn;
+}
+
+static bool same_flow(const struct ipa_rtk_flow *a, const struct ipa_rtk_flow *b)
+{
+	return same_tuple(&a->nat, &b->nat) && a->ingress_ifindex == b->ingress_ifindex &&
+		a->egress_ifindex == b->egress_ifindex && a->destination == b->destination &&
+		!memcmp(a->ethernet, b->ethernet, ETH_HLEN);
+}
+
+static u32 cookie_bucket(const void *binding, unsigned long cookie)
+{
+	return jhash_2words((u32)(unsigned long)binding, (u32)cookie, 0) &
+		(IPA_RTK_FLOW_BUCKETS - 1);
+}
+
+static u32 tuple_bucket(const void *binding, const struct ipa_rtk_nat_tuple *tuple)
+{
+	return jhash(tuple, sizeof(*tuple), (u32)(unsigned long)binding) &
+		(IPA_RTK_FLOW_BUCKETS - 1);
+}
+
+static struct ipa_rtk_managed_flow *find_cookie(struct ipa_rtk_flow_manager *m,
+		const void *binding, unsigned long cookie, unsigned int direction)
+{
+	struct ipa_rtk_cookie_ref *ref;
+	hlist_for_each_entry(ref, &m->cookies[cookie_bucket(binding, cookie)], node)
+		if ((direction > 1 || ref->direction == direction) &&
+		    ref->entry->binding == binding &&
+		    ref->entry->cookie[ref->direction] == cookie)
+			return ref->entry;
+	return NULL;
+}
+
+static struct ipa_rtk_managed_flow *find_tuple(struct ipa_rtk_flow_manager *m,
+		const void *binding, const struct ipa_rtk_nat_tuple *tuple)
+{
+	struct ipa_rtk_managed_flow *entry;
+	hlist_for_each_entry(entry, &m->tuples[tuple_bucket(binding, tuple)], tuple_node)
+		if (entry->binding == binding &&
+		    same_tuple(&entry->flow[entry->present[0] ? 0 : 1].nat, tuple))
+			return entry;
+	return NULL;
+}
+
+/* Called only after hardware references are gone, or for a never-published
+ * half-pair. No installed flow is evicted to make room for a new connection.
+ */
+static void forget_entry(struct ipa_rtk_flow_manager *m, struct ipa_rtk_managed_flow *entry)
+{
+	unsigned int dir;
+	hlist_del_init(&entry->tuple_node);
+	for (dir = 0; dir < 2; dir++)
+		hlist_del_init(&entry->refs[dir].node);
+	if (!list_empty(&entry->pending))
+		list_del_init(&entry->pending);
+	if (!list_empty(&entry->retiring))
+		list_del_init(&entry->retiring);
+	clear_bit(entry - m->entries, m->used);
+	memset(entry, 0, sizeof(*entry));
+}
+
+static void expire_pending(struct ipa_rtk_flow_manager *m)
+{
+	while (!list_empty(&m->pending)) {
+		struct ipa_rtk_managed_flow *entry =
+			list_first_entry(&m->pending, struct ipa_rtk_managed_flow, pending);
+		if (!time_after(jiffies, entry->lastused + 30 * HZ))
+			break;
+		forget_entry(m, entry);
+	}
+}
+
+static void fail_closed(struct ipa_rtk_flow_manager *m)
+{
+	m->failed = true;
+	m->ops->quiesce(m->private);
+}
+
+static int remove_entry(struct ipa_rtk_flow_manager *m, unsigned int index)
+{
+	struct ipa_rtk_managed_flow *entry = &m->entries[index];
+	int ret;
+	if (!entry->used)
+		return 0;
+	/* Disable translation first: an expired connection cannot continue to
+	 * forward while its classifiers are being removed. Referenced storage
+	 * stays allocated until all remove commands have completed.
+	 */
+	if (entry->nat.installed) {
+		ret = ipa_rtk_nat_pool_delete(&m->pool, &entry->nat);
+		if (ret)
+			goto fail;
+	}
+	if (entry->hardware) {
+		ret = m->ops->remove(m->private, index);
+		if (ret)
+			goto fail;
+	}
+	forget_entry(m, entry);
+	return 0;
+fail:
+	fail_closed(m);
+	return ret;
+}
+
+static void expire_retiring(struct ipa_rtk_flow_manager *m, bool force_one)
+{
+	while (!list_empty(&m->retiring)) {
+		struct ipa_rtk_managed_flow *entry =
+			list_first_entry(&m->retiring, struct ipa_rtk_managed_flow, retiring);
+		if (!force_one && !time_after_eq(jiffies, entry->retire_at)) {
+			unsigned long delay = entry->retire_at - jiffies;
+			mod_delayed_work(system_wq, &m->retire_work, delay ? delay : 1);
+			break;
+		}
+		if (remove_entry(m, entry - m->entries))
+			break;
+		if (force_one)
+			break;
+	}
+}
+
+static void retire_work_fn(struct work_struct *work)
+{
+	struct ipa_rtk_flow_manager *m =
+		container_of(to_delayed_work(work), struct ipa_rtk_flow_manager, retire_work);
+
+	mutex_lock(&m->lock);
+	if (m->active && !m->failed)
+		expire_retiring(m, false);
+	mutex_unlock(&m->lock);
+}
+
+static int managed_replace(void *private, const void *binding, unsigned long cookie,
+			   const struct ipa_rtk_flow *flow)
+{
+	struct ipa_rtk_flow_manager *m = private;
+	struct ipa_rtk_managed_flow *entry = NULL;
+	struct ipa_rtk_flow routed;
+	unsigned int dir;
+	int index = -1, ret = -EOPNOTSUPP;
+	bool lan_in, lan_out;
+
+	if (!flow || (flow->nat.protocol != IPPROTO_UDP &&
+		      flow->nat.protocol != IPPROTO_TCP))
+		return ret;
+	if (flow->identity) {
+		/* IP passthrough: the LAN host owns the WAN address. Express the
+		 * routed flow as NAT onto itself; the WAN-ingress half swaps ends
+		 * so both halves share one tuple.
+		 */
+		routed = *flow;
+		if (flow->ingress_ifindex == m->wan) {
+			routed.destination = true;
+			routed.nat.private_ip = flow->nat.remote_ip;
+			routed.nat.private_port = flow->nat.remote_port;
+			routed.nat.remote_ip = flow->nat.private_ip;
+			routed.nat.remote_port = flow->nat.private_port;
+		}
+		routed.nat.public_ip = routed.nat.private_ip;
+		routed.nat.public_port = routed.nat.private_port;
+		flow = &routed;
+	}
+	dir = flow->destination;
+	mutex_lock(&m->lock);
+	if (!m->active || m->failed) { ret = -ESHUTDOWN; goto out; }
+	lan_in = flow->ingress_ifindex == m->lan || flow->ingress_ifindex == m->bridge;
+	lan_out = flow->egress_ifindex == m->lan || flow->egress_ifindex == m->bridge;
+	if (flow->nat.public_ip != m->pool.public_ip ||
+	    (!dir && (!lan_in || flow->egress_ifindex != m->wan)) ||
+	    (dir && (flow->ingress_ifindex != m->wan || !lan_out)))
+		goto out;
+	expire_pending(m);
+	expire_retiring(m, false);
+	entry = find_cookie(m, binding, cookie, dir);
+	if (entry && entry->closing) {
+		ret = remove_entry(m, entry - m->entries);
+		if (ret)
+			goto out;
+		entry = NULL;
+	}
+	if (entry && !same_tuple(&entry->flow[dir].nat, &flow->nat)) {
+		ret = -ESTALE;
+		goto out;
+	}
+	if (!entry) {
+		entry = find_tuple(m, binding, &flow->nat);
+		if (entry && entry->closing) {
+			ret = remove_entry(m, entry - m->entries);
+			if (ret)
+				goto out;
+			entry = NULL;
+		}
+	}
+	if (!entry) {
+		index = find_first_zero_bit(m->used, IPA_RTK_FLOW_LIMIT);
+		if (index == IPA_RTK_FLOW_LIMIT && !list_empty(&m->retiring)) {
+			expire_retiring(m, true);
+			if (m->failed) { ret = -ESHUTDOWN; goto out; }
+			index = find_first_zero_bit(m->used, IPA_RTK_FLOW_LIMIT);
+		}
+		if (index == IPA_RTK_FLOW_LIMIT) { ret = -ENOSPC; goto out; }
+		entry = &m->entries[index];
+		INIT_LIST_HEAD(&entry->pending);
+		INIT_LIST_HEAD(&entry->retiring);
+		entry->binding = binding;
+		entry->used = true;
+		entry->lastused = jiffies;
+		set_bit(index, m->used);
+		list_add_tail(&entry->pending, &m->pending);
+	} else {
+		index = entry - m->entries;
+	}
+	if (entry->present[dir]) {
+		/* A cookie is one direction of one NF flow, not a replaceable tuple
+		 * pointer. Do not merge distinct connections that happen to share NAT.
+		 */
+		ret = entry->cookie[dir] == cookie &&
+			same_flow(&entry->flow[dir], flow) ?
+			(entry->hardware ? 0 : -EAGAIN) : -EEXIST;
+		goto out;
+	}
+	entry->flow[dir] = *flow;
+	entry->cookie[dir] = cookie;
+	entry->present[dir] = true;
+	entry->refs[dir].entry = entry;
+	entry->refs[dir].direction = dir;
+	hlist_add_head(&entry->refs[dir].node, &m->cookies[cookie_bucket(binding, cookie)]);
+	if (!entry->present[!dir]) {
+		hlist_add_head(&entry->tuple_node, &m->tuples[tuple_bucket(binding, &flow->nat)]);
+		ret = -EAGAIN;
+		goto out;
+	}
+	list_del_init(&entry->pending);
+	/* No success is reported for a pending half-pair. Only the callback that
+	 * has both independently supplied directions may activate hardware.
+	 */
+	ret = ipa_rtk_nat_pool_add(&m->pool, &flow->nat, &entry->nat);
+	if (ret == -ENOSPC && !list_empty(&m->retiring)) {
+		expire_retiring(m, true);
+		if (m->failed) { ret = -ESHUTDOWN; goto out; }
+		ret = ipa_rtk_nat_pool_add(&m->pool, &flow->nat, &entry->nat);
+	}
+	if (ret) {
+		if (m->pool.failed)
+			fail_closed(m);
+		else
+			forget_entry(m, entry);
+		goto out;
+	}
+	/* install must roll back partial classifiers or remove must handle them. */
+	entry->hardware = true;
+	ret = m->ops->install(m->private, index, entry->flow);
+	if (ret) {
+		int cleanup = remove_entry(m, index);
+		if (cleanup)
+			ret = cleanup;
+		goto out;
+	}
+	entry->lastused = jiffies;
+	entry->timestamp = 0;
+out:
+	mutex_unlock(&m->lock);
+	return ret;
+}
+
+static int managed_destroy(void *private, const void *binding, unsigned long cookie)
+{
+	struct ipa_rtk_flow_manager *m = private;
+	struct ipa_rtk_managed_flow *entry;
+	int ret = -ENOENT;
+	mutex_lock(&m->lock);
+	if (!m->active || m->failed) { ret = m->failed ? -ESHUTDOWN : -ENOENT; goto out; }
+	expire_retiring(m, false);
+	entry = find_cookie(m, binding, cookie, 2);
+	if (entry) {
+		/* Keep TCP hardware translation alive briefly across FIN/RST
+		 * teardown so in-flight data and SACK retransmissions before
+		 * FIN are not dropped by an immediate NAT miss.
+		 */
+		if (entry->hardware && entry->nat.installed &&
+		    entry->flow[0].nat.protocol == IPPROTO_TCP) {
+			unsigned int dir;
+			for (dir = 0; dir < 2; dir++) {
+				if (entry->present[dir] && entry->cookie[dir] == cookie)
+					hlist_del_init(&entry->refs[dir].node);
+			}
+			if (!entry->closing) {
+				entry->closing = true;
+				entry->retire_at = jiffies + IPA_RTK_TEARDOWN_GRACE;
+				list_add_tail(&entry->retiring, &m->retiring);
+				schedule_delayed_work(&m->retire_work, IPA_RTK_TEARDOWN_GRACE);
+			}
+			ret = 0;
+		} else {
+			ret = remove_entry(m, entry - m->entries);
+		}
+	}
+out:
+	mutex_unlock(&m->lock);
+	return ret;
+}
+
+static int managed_stats(void *private, const void *binding, unsigned long cookie,
+			 struct flow_stats *stats)
+{
+	struct ipa_rtk_flow_manager *m = private;
+	struct ipa_rtk_managed_flow *entry;
+	u32 timestamp;
+	int ret = -ENOENT;
+	mutex_lock(&m->lock);
+	if (!m->active || m->failed) { ret = m->failed ? -ESHUTDOWN : -ENOENT; goto out; }
+	entry = find_cookie(m, binding, cookie, 2);
+	if (!entry || !entry->hardware)
+		goto out;
+	timestamp = ipa_rtk_nat_pool_timestamp(&m->pool, &entry->nat);
+	if (timestamp != entry->timestamp) {
+		entry->timestamp = timestamp;
+		entry->lastused = jiffies;
+	}
+	/* IPA timestamps are shared by both directions; never invent counters. */
+	flow_stats_update(stats, 0, 0, 0, entry->lastused, FLOW_ACTION_HW_STATS_DELAYED);
+	ret = 0;
+out:
+	mutex_unlock(&m->lock);
+	return ret;
+}
+
+static void managed_flush(void *private, const void *binding)
+{
+	struct ipa_rtk_flow_manager *m = private;
+	unsigned int i;
+	mutex_lock(&m->lock);
+	if (!m->active) {
+		mutex_unlock(&m->lock);
+		return;
+	}
+	for (i = 0; i < IPA_RTK_FLOW_LIMIT; i++)
+		if (m->entries[i].used && m->entries[i].binding == binding) {
+			if (!m->failed)
+				remove_entry(m, i);
+			/* A failed entry stays quarantined, but cannot alias a newly
+			 * allocated binding when the old callback object is released.
+			 */
+			if (m->failed)
+				m->entries[i].binding = NULL;
+		}
+	mutex_unlock(&m->lock);
+}
+
+const struct ipa_rtk_flowtable_ops ipa_rtk_managed_flow_ops = {
+	.replace = managed_replace, .destroy = managed_destroy,
+	.stats = managed_stats, .flush = managed_flush,
+};
+
+int ipa_rtk_flow_manager_start(struct ipa_rtk_flow_manager *m, struct ipa *ipa,
+		__be32 public_ip, u32 source_metadata, u32 destination_metadata,
+		int lan, int bridge, int wan, const struct ipa_rtk_flow_manager_ops *ops,
+		void *private)
+{
+	int ret;
+	if (!m || m->active || !ops || !ops->install || !ops->remove || !ops->quiesce ||
+	    lan <= 0 || wan <= 0 || lan == wan || bridge == wan)
+		return -EINVAL;
+	mutex_lock(&m->lock);
+	m->entries = kvcalloc(IPA_RTK_FLOW_LIMIT, sizeof(*m->entries), GFP_KERNEL);
+	m->tuples = kvcalloc(IPA_RTK_FLOW_BUCKETS, sizeof(*m->tuples), GFP_KERNEL);
+	m->cookies = kvcalloc(IPA_RTK_FLOW_BUCKETS, sizeof(*m->cookies), GFP_KERNEL);
+	m->used = bitmap_zalloc(IPA_RTK_FLOW_LIMIT, GFP_KERNEL);
+	if (!m->entries || !m->tuples || !m->cookies || !m->used) {
+		ret = -ENOMEM;
+		goto free;
+	}
+	INIT_LIST_HEAD(&m->pending);
+	INIT_LIST_HEAD(&m->retiring);
+	INIT_DELAYED_WORK(&m->retire_work, retire_work_fn);
+	ret = ipa_rtk_nat_pool_create(&m->pool, ipa, public_ip, source_metadata, destination_metadata);
+	if (ret)
+		goto free;
+	m->lan = lan; m->bridge = bridge; m->wan = wan;
+	m->ops = ops; m->private = private;
+	m->failed = false;
+	m->active = true;
+	mutex_unlock(&m->lock);
+	return 0;
+free:
+	kvfree(m->entries); kvfree(m->tuples); kvfree(m->cookies);
+	bitmap_free(m->used);
+	m->entries = NULL; m->tuples = NULL; m->cookies = NULL; m->used = NULL;
+	mutex_unlock(&m->lock);
+	return ret;
+}
+
+int ipa_rtk_flow_manager_stop(struct ipa_rtk_flow_manager *m)
+{
+	unsigned int i;
+	int ret = 0;
+	if (!m || !m->active)
+		return -EINVAL;
+	cancel_delayed_work_sync(&m->retire_work);
+	mutex_lock(&m->lock);
+	if (m->failed) { ret = -ESHUTDOWN; goto out; }
+	for (i = 0; i < IPA_RTK_FLOW_LIMIT; i++) {
+		ret = remove_entry(m, i);
+		if (ret)
+			goto out;
+	}
+	ret = ipa_rtk_nat_pool_destroy(&m->pool);
+	if (ret)
+		fail_closed(m);
+	else {
+		m->active = false;
+		kvfree(m->entries); kvfree(m->tuples); kvfree(m->cookies);
+		bitmap_free(m->used);
+		m->entries = NULL; m->tuples = NULL; m->cookies = NULL; m->used = NULL;
+	}
+out:
+	mutex_unlock(&m->lock);
+	return ret;
+}
diff --git a/package/kernel/h5-ipa-rtk/src/ipa_rtk_flow_manager.h b/package/kernel/h5-ipa-rtk/src/ipa_rtk_flow_manager.h
new file mode 100644
index 00000000..401c448d
--- /dev/null
+++ b/package/kernel/h5-ipa-rtk/src/ipa_rtk_flow_manager.h
@@ -0,0 +1,61 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _IPA_RTK_FLOW_MANAGER_H_
+#define _IPA_RTK_FLOW_MANAGER_H_
+#include "ipa_rtk_flowtable.h"
+#include "ipa_rtk_nat_pool.h"
+#include <linux/list.h>
+#include <linux/workqueue.h>
+
+#define IPA_RTK_FLOW_LIMIT 4000
+#define IPA_RTK_FLOW_BUCKETS 1024
+#define IPA_RTK_TEARDOWN_GRACE (2 * HZ)
+struct ipa_rtk_managed_flow;
+struct ipa_rtk_cookie_ref {
+	struct hlist_node node;
+	struct ipa_rtk_managed_flow *entry;
+	unsigned int direction;
+};
+struct ipa_rtk_flow_manager_ops {
+	/* Publish/remove ONLY exact per-flow classifiers and route/header state.
+	 * NAT pool owns translation and remains alive until every filter is gone.
+	 */
+	int (*install)(void *private, unsigned int index, const struct ipa_rtk_flow flow[2]);
+	int (*remove)(void *private, unsigned int index);
+	/* Fail closed: synchronously disable external NIC DMA without freeing
+	 * referenced buffers. Owner must remain pinned until a confirmed reset.
+	 */
+	void (*quiesce)(void *private);
+};
+struct ipa_rtk_managed_flow {
+	struct hlist_node tuple_node;
+	struct ipa_rtk_cookie_ref refs[2];
+	struct list_head pending, retiring;
+	const void *binding;
+	unsigned long cookie[2], lastused, retire_at;
+	struct ipa_rtk_flow flow[2];
+	struct ipa_rtk_nat_slot nat;
+	u32 timestamp;
+	bool present[2], used, hardware, closing;
+};
+struct ipa_rtk_flow_manager {
+	struct mutex lock;
+	struct ipa_rtk_nat_pool pool;
+	struct ipa_rtk_managed_flow *entries;
+	struct hlist_head *tuples, *cookies;
+	unsigned long *used;
+	struct list_head pending, retiring;
+	struct delayed_work retire_work;
+	const struct ipa_rtk_flow_manager_ops *ops;
+	void *private;
+	int lan, bridge, wan;
+	bool active, failed;
+};
+extern const struct ipa_rtk_flowtable_ops ipa_rtk_managed_flow_ops;
+/* Manager is initially zeroed; caller holds IPA power throughout its life. */
+int ipa_rtk_flow_manager_start(struct ipa_rtk_flow_manager *manager, struct ipa *ipa,
+		__be32 public_ip, u32 source_metadata, u32 destination_metadata,
+		int lan, int bridge, int wan, const struct ipa_rtk_flow_manager_ops *ops,
+		void *private);
+/* Unregister flowtable first. Failure retains memory and requires reset. */
+int ipa_rtk_flow_manager_stop(struct ipa_rtk_flow_manager *manager);
+#endif
diff --git a/package/kernel/h5-ipa-rtk/src/ipa_rtk_flowtable.c b/package/kernel/h5-ipa-rtk/src/ipa_rtk_flowtable.c
new file mode 100644
index 00000000..609a814d
--- /dev/null
+++ b/package/kernel/h5-ipa-rtk/src/ipa_rtk_flowtable.c
@@ -0,0 +1,147 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/err.h>
+#include <linux/netdevice.h>
+#include <linux/rtnetlink.h>
+#include <linux/slab.h>
+#include "ipa_rtk_flowtable.h"
+
+struct ipa_rtk_binding {
+	struct list_head node;
+	struct ipa_rtk_flowtable *table;
+	void *data;
+	struct net_device *bound_dev;
+};
+
+static int ipa_rtk_flowtable_command(enum tc_setup_type type, void *data,
+				   void *private)
+{
+	struct ipa_rtk_binding *binding = private;
+	struct ipa_rtk_flowtable *table = binding->table;
+	struct flow_cls_offload *cls = data;
+	struct ipa_rtk_flow flow;
+	int ret;
+
+	if (type != TC_SETUP_CLSFLOWER || cls->common.chain_index)
+		return -EOPNOTSUPP;
+	switch (cls->command) {
+	case FLOW_CLS_REPLACE:
+		ret = ipa_rtk_flow_decode(cls->rule, &flow);
+		if (ret)
+			return ret;
+		return table->ops->replace(table->private, binding, cls->cookie, &flow);
+	case FLOW_CLS_DESTROY:
+		return table->ops->destroy(table->private, binding, cls->cookie);
+	case FLOW_CLS_STATS:
+		return table->ops->stats(table->private, binding, cls->cookie, &cls->stats);
+	default:
+		return -EOPNOTSUPP;
+	}
+}
+
+static void ipa_rtk_binding_release(void *private)
+{
+	struct ipa_rtk_binding *binding = private;
+
+	binding->table->ops->flush(binding->table->private, binding);
+	list_del(&binding->node);
+	kfree(binding);
+}
+
+static int ipa_rtk_flowtable_setup(struct net_device *dev, struct Qdisc *sch,
+		void *private, enum tc_setup_type type, void *type_data, void *data,
+		void (*cleanup)(struct flow_block_cb *))
+{
+	struct ipa_rtk_flowtable *table = private;
+	struct flow_block_offload *offload = type_data;
+	struct ipa_rtk_binding *binding, *found = NULL;
+	struct flow_block_cb *cb;
+	bool lan;
+
+	/* fw4 may name br-lan while NF resolves the actual path to its physical
+	 * Ethernet port. Accept that master as well, once per flowtable block.
+	 * NF invokes callbacks for both directions; do not bind again on WAN.
+	 */
+	if (type != TC_SETUP_FT || !dev)
+		return -EOPNOTSUPP;
+	rcu_read_lock();
+	lan = dev == table->lan ||
+		(netif_is_bridge_master(dev) && netdev_master_upper_dev_get_rcu(table->lan) == dev);
+	rcu_read_unlock();
+	if (!lan ||
+	    offload->binder_type != FLOW_BLOCK_BINDER_TYPE_CLSACT_INGRESS)
+		return -EOPNOTSUPP;
+	offload->unlocked_driver_cb = true;
+	offload->driver_block_list = &table->driver_blocks;
+	list_for_each_entry(binding, &table->bindings, node)
+		if (binding->data == data && binding->bound_dev == dev) {
+			found = binding;
+			break;
+		}
+	switch (offload->command) {
+	case FLOW_BLOCK_BIND:
+		if (found)
+			return -EEXIST;
+		binding = kzalloc(sizeof(*binding), GFP_KERNEL);
+		if (!binding)
+			return -ENOMEM;
+		binding->table = table;
+		binding->data = data;
+		binding->bound_dev = dev;
+		cb = flow_indr_block_cb_alloc(ipa_rtk_flowtable_command, binding,
+			binding, ipa_rtk_binding_release, offload, dev, sch,
+			data, table, cleanup);
+		if (IS_ERR(cb)) {
+			kfree(binding);
+			return PTR_ERR(cb);
+		}
+		list_add_tail(&binding->node, &table->bindings);
+		flow_block_cb_add(cb, offload);
+		list_add_tail(&cb->driver_list, &table->driver_blocks);
+		return 0;
+	case FLOW_BLOCK_UNBIND:
+		if (!found || found->bound_dev != dev)
+			return -ENOENT;
+		cb = flow_block_cb_lookup(offload->block,
+					 ipa_rtk_flowtable_command, found);
+		if (!cb)
+			return -ENOENT;
+		flow_indr_block_cb_remove(cb, offload);
+		list_del(&cb->driver_list);
+		return 0;
+	default:
+		return -EOPNOTSUPP;
+	}
+}
+
+int ipa_rtk_flowtable_register(struct ipa_rtk_flowtable *table,
+		struct net_device *lan, const struct ipa_rtk_flowtable_ops *ops,
+		void *private)
+{
+	int ret;
+	if (!table || !lan || !ops || !ops->replace || !ops->destroy ||
+	    !ops->stats || !ops->flush || table->registered)
+		return -EINVAL;
+	table->lan = lan;
+	table->ops = ops;
+	table->private = private;
+	INIT_LIST_HEAD(&table->bindings);
+	INIT_LIST_HEAD(&table->driver_blocks);
+	dev_hold(lan);
+	ret = flow_indr_dev_register(ipa_rtk_flowtable_setup, table);
+	if (ret) {
+		dev_put(lan);
+		return ret;
+	}
+	table->registered = true;
+	return 0;
+}
+
+void ipa_rtk_flowtable_unregister(struct ipa_rtk_flowtable *table)
+{
+	if (!table || !table->registered)
+		return;
+	flow_indr_dev_unregister(ipa_rtk_flowtable_setup, table, ipa_rtk_binding_release);
+	table->registered = false;
+	dev_put(table->lan);
+	table->lan = NULL;
+}
diff --git a/package/kernel/h5-ipa-rtk/src/ipa_rtk_flowtable.h b/package/kernel/h5-ipa-rtk/src/ipa_rtk_flowtable.h
new file mode 100644
index 00000000..ceee1105
--- /dev/null
+++ b/package/kernel/h5-ipa-rtk/src/ipa_rtk_flowtable.h
@@ -0,0 +1,40 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _IPA_RTK_FLOWTABLE_H_
+#define _IPA_RTK_FLOWTABLE_H_
+#include <linux/list.h>
+#include <net/flow_offload.h>
+#include "ipa_rtk_flow.h"
+
+struct net_device;
+struct ipa_rtk_flowtable;
+struct ipa_rtk_flowtable_ops {
+	/* A zero replace result means hardware forwarding is actually installed.
+	 * Cookies are opaque, scoped to binding, and must never be dereferenced.
+	 * All calls run in process context, serialized by the backend's lock.
+	 */
+	int (*replace)(void *private, const void *binding, unsigned long cookie,
+		       const struct ipa_rtk_flow *flow);
+	int (*destroy)(void *private, const void *binding, unsigned long cookie);
+	int (*stats)(void *private, const void *binding, unsigned long cookie,
+		     struct flow_stats *stats);
+	/* Synchronously remove all hardware rules owned by this binding. */
+	void (*flush)(void *private, const void *binding);
+};
+struct ipa_rtk_flowtable {
+	struct net_device *lan;
+	const struct ipa_rtk_flowtable_ops *ops;
+	void *private;
+	struct list_head bindings, driver_blocks;
+	bool registered;
+};
+/* Register only after CPU fallback and hardware teardown are operational.
+ * The caller owns LAN's lifetime through unregister; registration holds a ref.
+ * Both register and unregister must be called WITHOUT holding rtnl_lock or
+ * the backend's lock, because flow_indr_dev_unregister invokes the flowtable's
+ * cleanup callback (which flushesnf_ft_offload_del) and binding_release.
+ */
+int ipa_rtk_flowtable_register(struct ipa_rtk_flowtable *table,
+		struct net_device *lan, const struct ipa_rtk_flowtable_ops *ops,
+		void *private);
+void ipa_rtk_flowtable_unregister(struct ipa_rtk_flowtable *table);
+#endif
diff --git a/package/kernel/h5-ipa-rtk/src/ipa_rtk_modem_rules.h b/package/kernel/h5-ipa-rtk/src/ipa_rtk_modem_rules.h
new file mode 100644
index 00000000..00b52de6
--- /dev/null
+++ b/package/kernel/h5-ipa-rtk/src/ipa_rtk_modem_rules.h
@@ -0,0 +1,138 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _IPA_RTK_MODEM_RULES_H_
+#define _IPA_RTK_MODEM_RULES_H_
+#include "ipa_qmi_filter_schema.h"
+#include "ipa_rtk_rule_wire.h"
+
+/* Translate decoded QMI fields; do not confuse the QMI C layout with HW wire.
+ * IPA5 repurposes the legacy TOS equation bit as pure TCP ACK (value ignored).
+ */
+static inline int ipa_rtk_modem_equations(struct ipa_rtk_equations *eq,
+					 const struct h5_filter_rule_type *qmi)
+{
+	unsigned int i;
+	if (qmi->num_offset_meq_128 > 2 || qmi->num_offset_meq_32 > 2 ||
+	    qmi->num_ihl_offset_meq_32 > 2 || qmi->num_ihl_offset_range_16 > 2)
+		return -EINVAL;
+	memset(eq, 0, sizeof(*eq));
+	eq->bitmap = qmi->rule_eq_bitmap;
+	eq->pure_ack = qmi->tos_eq_present;
+	eq->protocol_present = qmi->protocol_eq_present;
+	eq->protocol = qmi->protocol_eq;
+	eq->tc_present = qmi->tc_eq_present;
+	eq->tc = qmi->tc_eq;
+	eq->meq128_count = qmi->num_offset_meq_128;
+	eq->meq32_count = qmi->num_offset_meq_32;
+	eq->ihl_meq32_count = qmi->num_ihl_offset_meq_32;
+	eq->range16_count = qmi->num_ihl_offset_range_16;
+	for (i = 0; i < eq->meq128_count; i++) {
+		eq->meq128[i].offset = qmi->offset_meq_128[i].offset;
+		memcpy(eq->meq128[i].mask, qmi->offset_meq_128[i].mask, 16);
+		memcpy(eq->meq128[i].value, qmi->offset_meq_128[i].value, 16);
+	}
+	for (i = 0; i < eq->meq32_count; i++) {
+		eq->meq32[i].offset = qmi->offset_meq_32[i].offset;
+		eq->meq32[i].mask = qmi->offset_meq_32[i].mask;
+		eq->meq32[i].value = qmi->offset_meq_32[i].value;
+	}
+	for (i = 0; i < eq->ihl_meq32_count; i++) {
+		eq->ihl_meq32[i].offset = qmi->ihl_offset_meq_32[i].offset;
+		eq->ihl_meq32[i].mask = qmi->ihl_offset_meq_32[i].mask;
+		eq->ihl_meq32[i].value = qmi->ihl_offset_meq_32[i].value;
+	}
+	for (i = 0; i < eq->range16_count; i++) {
+		eq->range16[i].offset = qmi->ihl_offset_range_16[i].offset;
+		eq->range16[i].low = qmi->ihl_offset_range_16[i].range_low;
+		eq->range16[i].high = qmi->ihl_offset_range_16[i].range_high;
+	}
+	eq->metadata_present = qmi->metadata_meq32_present;
+	eq->metadata.offset = qmi->metadata_meq32.offset;
+	eq->metadata.mask = qmi->metadata_meq32.mask;
+	eq->metadata.value = qmi->metadata_meq32.value;
+	eq->ihl_eq32_present = qmi->ihl_offset_eq_32_present;
+	eq->ihl_eq32_offset = qmi->ihl_offset_eq_32.offset;
+	eq->ihl_eq32 = qmi->ihl_offset_eq_32.value;
+	eq->ihl_eq16_present = qmi->ihl_offset_eq_16_present;
+	eq->ihl_eq16_offset = qmi->ihl_offset_eq_16.offset;
+	eq->ihl_eq16 = qmi->ihl_offset_eq_16.value;
+	eq->flow_present = qmi->flow_eq_present;
+	eq->flow = qmi->flow_eq;
+	eq->fragment = qmi->ipv4_frag_eq_present;
+	return 0;
+}
+
+/* Build IPv4 stock-style SRC_NAT UL policy, but never activate a NAT entry.
+ * Empty/missing hardware NAT tuples must fall back to the Linux firewall.
+ * Caller adds CPU fallback after the returned byte count, then publishes and
+ * ONLY THEN sends this notification. IPv6 is deliberately not authorized here.
+ */
+static inline int ipa_rtk_modem_ul_build(const struct h5_install_fltr_rule_req_msg *rules,
+		u8 *buffer, size_t capacity, u8 mux,
+		struct h5_fltr_installed_notif_req_msg *notification)
+{
+	unsigned int i, cursor = 0, count = 0;
+	if (!rules || !buffer || !notification ||
+	    !rules->filter_spec_ex_list_valid || rules->filter_spec_ex_list_len > 64 ||
+	    rules->filter_spec_ex2_list_valid || !mux)
+		return -EOPNOTSUPP;
+	memset(notification, 0, sizeof(*notification));
+	/* Prepend TCP FIN and RST exception rules (priorities 1..2) so TCP
+	 * teardown packets always go to AP_LAN_RX (EP16) for nf_flowtable
+	 * teardown instead of hitting SRC_NAT.
+	 */
+	for (i = 0; i < 2; i++) {
+		struct ipa_rtk_equations fin_rst = {};
+		int length;
+
+		if (cursor > capacity || capacity - cursor < 256)
+			return -ENOSPC;
+		fin_rst.bitmap = BIT(1) | BIT(7);
+		fin_rst.protocol_present = 1;
+		fin_rst.protocol = 6; /* IPPROTO_TCP */
+		fin_rst.ihl_meq32_count = 1;
+		fin_rst.ihl_meq32[0].offset = 12;
+		fin_rst.ihl_meq32[0].mask = i == 0 ? 0x00010000U : 0x00040000U;
+		fin_rst.ihl_meq32[0].value = fin_rst.ihl_meq32[0].mask;
+		length = ipa_rtk_filter_encode(buffer + cursor, &fin_rst,
+			0, 3 /* EXCEPTION */, 0, 1 + i, 704 + i, 0, 0, 0);
+		if (length < 0)
+			return length;
+		cursor += length;
+	}
+	for (i = 0; i < rules->filter_spec_ex_list_len; i++) {
+		const struct h5_filter_spec_ex_type *r = &rules->filter_spec_ex_list[i];
+		struct ipa_rtk_equations eq;
+		int length, ret;
+		if (r->ip_type != 0)
+			continue;
+		if (!r->is_routing_table_index_valid || r->route_table_index > 10 ||
+		    r->rule_id >= 1023 || (r->is_mux_id_valid && r->mux_id != mux))
+			return -EOPNOTSUPP;
+		if (cursor > capacity || capacity - cursor < 256)
+			return -ENOSPC;
+		ret = ipa_rtk_modem_equations(&eq, &r->filter_rule);
+		if (ret)
+			return ret;
+		length = ipa_rtk_filter_encode(buffer + cursor, &eq,
+			r->route_table_index, 1 /* SRC_NAT */, 0, 16 + count,
+			r->rule_id, 0, 0, 0);
+		if (length < 0)
+			return length;
+		cursor += length;
+		notification->rule_id[count++] = r->rule_id;
+	}
+	if (!count)
+		return -ENODATA;
+	notification->source_pipe_index = 8;
+	notification->install_status = 0; /* QMI_RESULT_SUCCESS */
+	notification->rule_id_valid = 1;
+	notification->rule_id_len = count;
+	notification->embedded_pipe_index_valid = 1;
+	notification->embedded_pipe_index = 2; /* AP_LAN_WAN_PROD */
+	notification->retain_header_valid = 1;
+	notification->retain_header = 0;
+	notification->embedded_call_mux_id_valid = 1;
+	notification->embedded_call_mux_id = mux;
+	return cursor;
+}
+#endif
diff --git a/package/kernel/h5-ipa-rtk/src/ipa_rtk_nat.h b/package/kernel/h5-ipa-rtk/src/ipa_rtk_nat.h
new file mode 100644
index 00000000..87341b89
--- /dev/null
+++ b/package/kernel/h5-ipa-rtk/src/ipa_rtk_nat.h
@@ -0,0 +1,33 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _IPA_RTK_NAT_H_
+#define _IPA_RTK_NAT_H_
+
+#include <linux/dma-mapping.h>
+#include <linux/types.h>
+
+struct ipa;
+
+struct ipa_rtk_nat_layout {
+	dma_addr_t base;
+	dma_addr_t expansion;
+	dma_addr_t index;
+	dma_addr_t index_expansion;
+	u16 base_mask;
+	u16 expansion_count;
+};
+
+/* A single 16-byte PDN record, in IPA wire order. */
+struct ipa_rtk_pdn {
+	__le32 public_ip;
+	__le32 source_metadata;
+	__le32 destination_metadata;
+	__le32 reserved;
+};
+
+/* Coherent buffers remain owned by hardware until a replacement init and drain. */
+int ipa_cmd_rtk_nat_init(struct ipa *ipa, const struct ipa_rtk_nat_layout *layout,
+			 dma_addr_t pdn_record);
+int ipa_cmd_rtk_nat_dma(struct ipa *ipa, u8 table, u32 offset, u16 value);
+int ipa_cmd_rtk_nat_disable(struct ipa *ipa);
+
+#endif
diff --git a/package/kernel/h5-ipa-rtk/src/ipa_rtk_nat_pool.c b/package/kernel/h5-ipa-rtk/src/ipa_rtk_nat_pool.c
new file mode 100644
index 00000000..27ac6bb9
--- /dev/null
+++ b/package/kernel/h5-ipa-rtk/src/ipa_rtk_nat_pool.c
@@ -0,0 +1,300 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/bitmap.h>
+#include <linux/dma-mapping.h>
+#include <linux/in.h>
+#include <linux/slab.h>
+#include "ipa.h"
+#include "ipa_mem.h"
+#include "ipa_rtk_nat_pool.h"
+
+#define IPA_RTK_NAT_BASE 4096
+#define IPA_RTK_NAT_EXPANSION 800
+#define IPA_RTK_NAT_LIMIT 4000
+
+struct ipa_rtk_nat_node {
+	u16 next[2], previous[2];
+	struct ipa_rtk_nat_slot *owner[2];
+	struct ipa_rtk_nat_tuple tuple;
+};
+
+/* dir 0 is the destination NAT graph; dir 1 is the source index graph. */
+static void *node_address(struct ipa_rtk_nat_pool *p, unsigned int dir, u16 n)
+{
+	return p->buffer + (dir ? p->total * 32 + n * 4 : n * 32);
+}
+
+static int write_node(struct ipa_rtk_nat_pool *p, unsigned int dir, u16 n,
+		      unsigned int field, u16 value)
+{
+	return ipa_cmd_rtk_nat_dma(p->ipa, dir * 2 + (n >= p->count),
+		(n >= p->count ? n - p->count : n) * (dir ? 4 : 32) + field, value);
+}
+
+static bool key_equal(const struct ipa_rtk_nat_tuple *a,
+		      const struct ipa_rtk_nat_tuple *b, unsigned int dir)
+{
+	return a->remote_ip == b->remote_ip && a->remote_port == b->remote_port &&
+		a->protocol == b->protocol && (dir ?
+		(a->private_ip == b->private_ip && a->private_port == b->private_port) :
+		(a->public_ip == b->public_ip && a->public_port == b->public_port));
+}
+
+/* Resolve a chain without modifying either software or DMA-visible state. */
+static int reserve_node(struct ipa_rtk_nat_pool *p, unsigned int dir, u16 hash,
+			const struct ipa_rtk_nat_tuple *tuple, u16 *index, u16 *tail)
+{
+	unsigned long *used = dir ? p->sources : p->destinations;
+	u16 n = hash;
+	unsigned int walked = 0;
+
+	*tail = 0;
+	if (!test_bit(n, used)) { *index = n; return 0; }
+	for (;;) {
+		if (!n || n >= p->total || !test_bit(n, used) || ++walked > p->total)
+			return -EUCLEAN;
+		if (p->nodes[n].owner[dir] && key_equal(&p->nodes[
+			dir ? p->nodes[n].owner[dir]->destination : n].tuple, tuple, dir))
+			return -EEXIST;
+		if (!p->nodes[n].next[dir])
+			break;
+		n = p->nodes[n].next[dir];
+	}
+	*tail = n;
+	n = find_next_zero_bit(used, p->total, p->count);
+	if (n == p->total)
+		return -ENOSPC;
+	*index = n;
+	return 0;
+}
+
+static DEFINE_MUTEX(pool_owner_lock);
+static struct ipa_rtk_nat_pool *pool_owner;
+
+int ipa_rtk_nat_pool_create(struct ipa_rtk_nat_pool *p, struct ipa *ipa,
+			   __be32 public_ip, u32 source_metadata, u32 destination_metadata)
+{
+	const struct ipa_mem *pdn = NULL;
+	struct ipa_rtk_pdn *record;
+	unsigned int i;
+	int ret = -EBUSY;
+	if (!p || p->ipa || !ipa || !public_ip || ipa->version != IPA_VERSION_5_0)
+		return -EINVAL;
+	mutex_lock(&pool_owner_lock);
+	if (pool_owner)
+		goto out;
+	for (i = 0; i < ipa->mem_count; i++)
+		if (ipa->mem[i].id == IPA_MEM_PDN_CONFIG)
+			pdn = &ipa->mem[i];
+	if (!pdn || pdn->size < 16) { ret = -ENODEV; goto out; }
+	p->count = IPA_RTK_NAT_BASE;
+	p->total = p->count + IPA_RTK_NAT_EXPANSION;
+	p->size = p->total * 36 + 32;
+	p->nodes = kvcalloc(p->total, sizeof(*p->nodes), GFP_KERNEL);
+	p->destinations = bitmap_zalloc(p->total, GFP_KERNEL);
+	p->sources = bitmap_zalloc(p->total, GFP_KERNEL);
+	p->buffer = dma_alloc_coherent(ipa->dev, p->size, &p->address, GFP_KERNEL);
+	if (!p->nodes || !p->destinations || !p->sources || !p->buffer) {
+		ret = -ENOMEM;
+		goto free;
+	}
+	memset(p->buffer, 0, p->size);
+	memcpy_fromio(p->buffer + p->size - 16,
+		ipa->mem_virt + ipa->mem_offset + pdn->offset, 16);
+	record = p->buffer + p->size - 32;
+	record->public_ip = cpu_to_le32(be32_to_cpu(public_ip));
+	record->source_metadata = cpu_to_le32(source_metadata);
+	record->destination_metadata = cpu_to_le32(destination_metadata);
+	p->layout.base = p->address;
+	p->layout.expansion = p->address + p->count * 32;
+	p->layout.index = p->address + p->total * 32;
+	p->layout.index_expansion = p->layout.index + p->count * 4;
+	p->layout.base_mask = p->count - 1;
+	p->layout.expansion_count = IPA_RTK_NAT_EXPANSION;
+	p->failed = false;
+	mutex_init(&p->lock);
+	ret = ipa_cmd_rtk_nat_init(ipa, &p->layout, p->address + p->size - 32);
+	if (ret)
+		goto free;
+	p->ipa = ipa;
+	p->public_ip = public_ip;
+	p->active = true;
+	pool_owner = p;
+	goto out;
+free:
+	if (p->buffer)
+		dma_free_coherent(ipa->dev, p->size, p->buffer, p->address);
+	bitmap_free(p->sources);
+	bitmap_free(p->destinations);
+	kvfree(p->nodes);
+	memset(p, 0, sizeof(*p));
+out:
+	mutex_unlock(&pool_owner_lock);
+	return ret;
+}
+
+int ipa_rtk_nat_pool_add(struct ipa_rtk_nat_pool *p,
+		const struct ipa_rtk_nat_tuple *tuple, struct ipa_rtk_nat_slot *slot)
+{
+	u16 source, destination, tail[2];
+	unsigned int dir;
+	int ret;
+	if (!p || !p->ipa || !tuple || !slot || slot->installed || tuple->pdn ||
+	    tuple->public_ip != p->public_ip ||
+	    (tuple->protocol != IPPROTO_UDP && tuple->protocol != IPPROTO_TCP))
+		return -EINVAL;
+	mutex_lock(&p->lock);
+	if (!p->active || p->failed) { ret = -ESHUTDOWN; goto out; }
+	if (p->active_count >= IPA_RTK_NAT_LIMIT) { ret = -ENOSPC; goto out; }
+	ret = reserve_node(p, 0, ipa_rtk_nat_destination_hash(tuple, p->count - 1),
+			   tuple, &destination, &tail[0]);
+	if (!ret)
+		ret = reserve_node(p, 1, ipa_rtk_nat_source_hash(tuple, p->count - 1),
+				   tuple, &source, &tail[1]);
+	if (ret) {
+		if (ret == -EUCLEAN) p->failed = true;
+		goto out;
+	}
+	ipa_rtk_nat_encode(node_address(p, 0, destination), tuple, 0, 0);
+	/* An unlinked expansion index is private until its predecessor links it. */
+	memset(node_address(p, 1, source), 0, 4);
+	dma_wmb();
+	ret = write_node(p, 0, destination, 18, 0x8000);
+	if (!ret && tail[0]) ret = write_node(p, 0, tail[0], 8, destination);
+	if (!ret) ret = write_node(p, 1, source, 0, destination);
+	if (!ret && tail[1]) ret = write_node(p, 1, tail[1], 2, source);
+	if (ret) { p->failed = true; goto out; }
+	p->nodes[destination].tuple = *tuple;
+	slot->source = source;
+	slot->destination = destination;
+	slot->installed = true;
+	for (dir = 0; dir < 2; dir++) {
+		u16 n = dir ? source : destination;
+		p->nodes[n].owner[dir] = slot;
+		p->nodes[n].previous[dir] = tail[dir];
+		p->nodes[n].next[dir] = 0;
+		if (tail[dir]) p->nodes[tail[dir]].next[dir] = n;
+		set_bit(n, dir ? p->sources : p->destinations);
+	}
+	p->active_count++;
+out:
+	mutex_unlock(&p->lock);
+	return ret;
+}
+
+int ipa_rtk_nat_pool_delete(struct ipa_rtk_nat_pool *p, struct ipa_rtk_nat_slot *slot)
+{
+	u16 d, s, next, previous;
+	int ret = 0;
+	if (!p || !p->ipa || !slot)
+		return -EINVAL;
+	mutex_lock(&p->lock);
+	if (!slot->installed) goto out;
+	d = slot->destination; s = slot->source;
+	if (!d || !s || d >= p->total || s >= p->total ||
+	    p->nodes[d].owner[0] != slot || p->nodes[s].owner[1] != slot) {
+		ret = -EINVAL; goto out;
+	}
+	if (p->failed || !p->active) { ret = -ESHUTDOWN; goto out; }
+	/* A base head must stay enabled for the hardware to traverse successors.
+	 * Stock invalidates its protocol instead. Never reuse this sentinel until
+	 * the chain becomes empty. Every command drains prior pipeline readers.
+	 */
+	ret = d < p->count && p->nodes[d].next[0] ?
+		write_node(p, 0, d, 22, 0xff00) : write_node(p, 0, d, 18, 0);
+	if (ret) goto failed;
+	next = p->nodes[s].next[1]; previous = p->nodes[s].previous[1];
+	if (!previous && next) {
+		struct ipa_rtk_nat_slot *promoted = p->nodes[next].owner[1];
+		if (!promoted) { ret = -EUCLEAN; goto failed; }
+		/* Preserve the chain while promoting the first expansion element. */
+		ret = write_node(p, 1, s, 2, p->nodes[next].next[1]);
+		if (!ret) ret = write_node(p, 1, s, 0, promoted->destination);
+		if (ret) goto failed;
+		p->nodes[s].owner[1] = promoted;
+		p->nodes[s].next[1] = p->nodes[next].next[1];
+		if (p->nodes[s].next[1]) p->nodes[p->nodes[s].next[1]].previous[1] = s;
+		promoted->source = s;
+		s = next;
+	} else {
+		ret = write_node(p, 1, previous ? previous : s, previous ? 2 : 0, next);
+		if (ret) goto failed;
+		if (previous) p->nodes[previous].next[1] = next;
+		if (next) p->nodes[next].previous[1] = previous;
+	}
+	p->nodes[s].owner[1] = NULL;
+	p->nodes[s].next[1] = p->nodes[s].previous[1] = 0;
+	memset(node_address(p, 1, s), 0, 4);
+	clear_bit(s, p->sources);
+
+	next = p->nodes[d].next[0]; previous = p->nodes[d].previous[0];
+	p->nodes[d].owner[0] = NULL;
+	if (previous || !next) {
+		if (previous) {
+			ret = write_node(p, 0, previous, 8, next);
+			if (ret) goto failed;
+			p->nodes[previous].next[0] = next;
+			if (next) p->nodes[next].previous[0] = previous;
+		}
+		memset(node_address(p, 0, d), 0, 32);
+		p->nodes[d].next[0] = p->nodes[d].previous[0] = 0;
+		clear_bit(d, p->destinations);
+		if (previous && !next && previous < p->count && !p->nodes[previous].owner[0]) {
+			ret = write_node(p, 0, previous, 18, 0);
+			if (ret) goto failed;
+			memset(node_address(p, 0, previous), 0, 32);
+			clear_bit(previous, p->destinations);
+		}
+	}
+	p->active_count--;
+	memset(slot, 0, sizeof(*slot));
+	goto out;
+failed:
+	/* Unknown partially published state stays allocated until reset. */
+	p->failed = true;
+out:
+	mutex_unlock(&p->lock);
+	return ret;
+}
+
+u32 ipa_rtk_nat_pool_timestamp(struct ipa_rtk_nat_pool *p, const struct ipa_rtk_nat_slot *slot)
+{
+	const struct ipa_rtk_nat_entry *entry;
+	u32 timestamp = 0;
+	if (!p || !p->ipa || !slot)
+		return 0;
+	mutex_lock(&p->lock);
+	if (p->active && slot->installed && slot->destination < p->total) {
+		entry = p->buffer + slot->destination * 32;
+		dma_rmb();
+		timestamp = le32_to_cpu(READ_ONCE(entry->word[5])) & 0xffffff;
+	}
+	mutex_unlock(&p->lock);
+	return timestamp;
+}
+
+int ipa_rtk_nat_pool_destroy(struct ipa_rtk_nat_pool *p)
+{
+	int ret = 0;
+	if (!p || !p->ipa)
+		return -EINVAL;
+	mutex_lock(&pool_owner_lock);
+	mutex_lock(&p->lock);
+	if (pool_owner != p) { ret = -EINVAL; goto out; }
+	ret = ipa_cmd_rtk_nat_init(p->ipa, &p->layout, p->address + p->size - 16);
+	if (!ret)
+		ret = ipa_cmd_rtk_nat_disable(p->ipa);
+	if (ret) { p->failed = true; goto out; }
+	p->active = false;
+	dma_free_coherent(p->ipa->dev, p->size, p->buffer, p->address);
+	bitmap_free(p->sources);
+	bitmap_free(p->destinations);
+	kvfree(p->nodes);
+	p->buffer = NULL;
+	p->nodes = NULL;
+	p->ipa = NULL;
+	pool_owner = NULL;
+out:
+	mutex_unlock(&p->lock);
+	mutex_unlock(&pool_owner_lock);
+	return ret;
+}
diff --git a/package/kernel/h5-ipa-rtk/src/ipa_rtk_nat_pool.h b/package/kernel/h5-ipa-rtk/src/ipa_rtk_nat_pool.h
new file mode 100644
index 00000000..bbce8430
--- /dev/null
+++ b/package/kernel/h5-ipa-rtk/src/ipa_rtk_nat_pool.h
@@ -0,0 +1,42 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _IPA_RTK_NAT_POOL_H_
+#define _IPA_RTK_NAT_POOL_H_
+#include <linux/mutex.h>
+#include "ipa_rtk_nat.h"
+#include "ipa_rtk_nat_wire.h"
+
+struct ipa;
+struct ipa_rtk_nat_slot {
+	u16 source, destination;
+	bool installed;
+};
+struct ipa_rtk_nat_pool {
+	struct ipa *ipa;
+	struct mutex lock;
+	struct ipa_rtk_nat_layout layout;
+	void *buffer;
+	dma_addr_t address;
+	size_t size;
+	unsigned long *destinations, *sources;
+	u16 count, total, active_count;
+	/* Indices use the IPA ABI: base entries followed by expansion entries.
+	 * Separate graphs are required because the two hashes collide differently.
+	 */
+	struct ipa_rtk_nat_node *nodes;
+	__be32 public_ip;
+	bool active, failed;
+};
+/* Caller holds IPA power and stops/removes every referencing filter before
+ * destroy. Exhaustion returns ENOSPC and leaves the packet on CPU fallback.
+ */
+int ipa_rtk_nat_pool_create(struct ipa_rtk_nat_pool *pool, struct ipa *ipa,
+			   __be32 public_ip, u32 source_metadata, u32 destination_metadata);
+/* TCP classifiers MUST exclude FIN/RST; bit14 redirects ordinary data on H5.
+ * The pool only enables the NAT entry (bit15), never TCP redirect.
+ */
+int ipa_rtk_nat_pool_add(struct ipa_rtk_nat_pool *pool,
+		const struct ipa_rtk_nat_tuple *tuple, struct ipa_rtk_nat_slot *slot);
+int ipa_rtk_nat_pool_delete(struct ipa_rtk_nat_pool *pool, struct ipa_rtk_nat_slot *slot);
+u32 ipa_rtk_nat_pool_timestamp(struct ipa_rtk_nat_pool *pool, const struct ipa_rtk_nat_slot *slot);
+int ipa_rtk_nat_pool_destroy(struct ipa_rtk_nat_pool *pool);
+#endif
diff --git a/package/kernel/h5-ipa-rtk/src/ipa_rtk_nat_wire.h b/package/kernel/h5-ipa-rtk/src/ipa_rtk_nat_wire.h
new file mode 100644
index 00000000..f9e17b77
--- /dev/null
+++ b/package/kernel/h5-ipa-rtk/src/ipa_rtk_nat_wire.h
@@ -0,0 +1,91 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _IPA_RTK_NAT_WIRE_H_
+#define _IPA_RTK_NAT_WIRE_H_
+
+#include <linux/types.h>
+#ifdef __KERNEL__
+#include <linux/byteorder/generic.h>
+#else
+#include <endian.h>
+#define cpu_to_le32(x) htole32(x)
+#define be32_to_cpu(x) be32toh(x)
+#define be16_to_cpu(x) be16toh(x)
+#endif
+
+/* Wire layout from Qualcomm ipanat ipa_nat_rule; use words, not C bitfields. */
+struct ipa_rtk_nat_entry {
+	__le32 word[8];
+};
+
+struct ipa_rtk_nat_tuple {
+	__be32 private_ip;
+	__be32 remote_ip;
+	__be32 public_ip;
+	__be16 private_port;
+	__be16 remote_port;
+	__be16 public_port;
+	__u8 protocol;
+	__u8 pdn;
+};
+
+static inline __u16 ipa_rtk_nat_checksum_delta(__u32 public_ip, __u16 public_port,
+					     __u32 private_ip, __u16 private_port)
+{
+	__u32 sum = (public_ip & 0xffff) + (public_ip >> 16) + public_port;
+
+	sum += (~private_ip & 0xffff) + ((~private_ip) >> 16);
+	sum += (__u16)~private_port;
+	while (sum >> 16)
+		sum = (sum & 0xffff) + (sum >> 16);
+	return sum;
+}
+
+static inline __u16 ipa_rtk_nat_destination_hash(const struct ipa_rtk_nat_tuple *t,
+					       __u16 mask)
+{
+	__u32 remote = be32_to_cpu(t->remote_ip);
+	__u32 public = be32_to_cpu(t->public_ip);
+	__u16 hash;
+
+	hash = remote ^ (remote >> 16) ^ public ^ (public >> 16) ^
+		be16_to_cpu(t->remote_port) ^ be16_to_cpu(t->public_port) ^ t->protocol;
+	hash &= mask;
+	return hash ? hash : mask;
+}
+
+static inline __u16 ipa_rtk_nat_source_hash(const struct ipa_rtk_nat_tuple *t, __u16 mask)
+{
+	__u32 remote = be32_to_cpu(t->remote_ip);
+	__u32 private = be32_to_cpu(t->private_ip);
+	__u16 hash;
+
+	hash = remote ^ (remote >> 16) ^ private ^ (private >> 16) ^
+		be16_to_cpu(t->remote_port) ^ be16_to_cpu(t->private_port) ^ t->protocol;
+	hash &= mask;
+	return hash ? hash : mask;
+}
+
+static inline void ipa_rtk_nat_encode(struct ipa_rtk_nat_entry *entry,
+				     const struct ipa_rtk_nat_tuple *t,
+				     __u16 next, __u16 flags)
+{
+	__u32 public = be32_to_cpu(t->public_ip);
+	__u32 private = be32_to_cpu(t->private_ip);
+	__u16 public_port = be16_to_cpu(t->public_port);
+	__u16 private_port = be16_to_cpu(t->private_port);
+	__u16 ip_delta, transport_delta;
+
+	ip_delta = ipa_rtk_nat_checksum_delta(public, 0, private, 0);
+	transport_delta = ipa_rtk_nat_checksum_delta(public, public_port, private, private_port);
+	entry->word[0] = cpu_to_le32(private);
+	entry->word[1] = cpu_to_le32(be32_to_cpu(t->remote_ip));
+	entry->word[2] = cpu_to_le32(next | (__u32)public_port << 16);
+	entry->word[3] = cpu_to_le32(private_port | (__u32)be16_to_cpu(t->remote_port) << 16);
+	entry->word[4] = cpu_to_le32(ip_delta | (__u32)flags << 16);
+	entry->word[5] = cpu_to_le32((__u32)t->protocol << 24);
+	entry->word[6] = 0;
+	entry->word[7] = cpu_to_le32((__u32)(t->pdn & 0xf) << 12 |
+				   (__u32)transport_delta << 16);
+}
+
+#endif
