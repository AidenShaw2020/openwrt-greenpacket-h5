+/*
+ * RTL8125 external rings on SDX65 IPA v5.0.  The protocol and scratch format
+ * follow Qualcomm dataipa ipa_eth_i.c / gsi_rtk_channel_scratch.  The H5 stock
+ * ipa3_ep_mapping selects channels 18 (producer) and 21 (consumer).
+ * Included in gsi.c to reuse its serialized hardware command implementation.
+ */
+
+#define GSI_RTK_ELEMENT_SIZE	32U
+#define GSI_RTK_PCIE_SELECT	BIT_ULL(40)
+
+static void gsi_rtk_write(struct gsi *gsi, enum gsi_reg_id id, u32 index,
+			  u32 value)
+{
+	const struct reg *reg = gsi_reg(gsi, id);
+
+	iowrite32(value, gsi->virt + reg_n_offset(reg, index));
+}
+
+static int gsi_rtk_validate(struct gsi *gsi, const struct gsi_rtk_config *c)
+{
+	u64 buffer_end;
+	u32 tail;
+
+	if (gsi->version != IPA_VERSION_5_0)
+		return -EOPNOTSUPP;
+	if (!is_power_of_2(c->ring_size) || c->ring_size < 64 ||
+	    c->ring_size > SZ_1M || !IS_ALIGNED(c->ring_addr, c->ring_size))
+		return -EINVAL;
+	if (!is_power_of_2(c->buffer_size) || c->buffer_size < 2048 ||
+	    c->buffer_size > 4096 ||
+	    !IS_ALIGNED(c->buffer_addr, c->buffer_size))
+		return -EINVAL;
+	if (c->queue > (c->toward_ipa ? 15 : 1))
+		return -EINVAL;
+	tail = c->toward_ipa ? 0 : 0x2800 + 4 * c->queue;
+	if (c->tail_offset != tail || c->bar_size < tail + sizeof(u32) ||
+	    !IS_ALIGNED(c->bar_addr, sizeof(u32)))
+		return -EINVAL;
+	/* RTK scratch: 41-bit PCIe address and 40-bit shared-buffer IOVA. */
+	buffer_end = c->buffer_addr +
+		(u64)(c->ring_size / GSI_RTK_ELEMENT_SIZE) * c->buffer_size;
+	if (!c->bar_addr || c->bar_addr >= GSI_RTK_PCIE_SELECT ||
+	    c->bar_addr + c->bar_size > GSI_RTK_PCIE_SELECT ||
+	    buffer_end > BIT_ULL(40) || buffer_end <= c->buffer_addr ||
+	    c->ring_addr >= BIT_ULL(40))
+		return -ERANGE;
+	/* Event doorbell is outside the ring.  Its low 32 bits must not wrap. */
+	if ((u64)lower_32_bits(c->ring_addr) + c->ring_size +
+	    GSI_RTK_ELEMENT_SIZE > U32_MAX)
+		return -ERANGE;
+	return 0;
+}
+
+static void gsi_rtk_program(struct gsi_rtk *rtk,
+			    const struct gsi_rtk_config *c)
+{
+	struct gsi *gsi = rtk->gsi;
+	u32 ch = rtk->channel_id, ev = rtk->event_id;
+	u64 bar = c->bar_addr | GSI_RTK_PCIE_SELECT;
+	u64 msi = bar + c->tail_offset;
+	const struct reg *reg;
+	u32 queue, value;
+
+	reg = gsi_reg(gsi, EV_CH_E_CNTXT_0);
+	value = reg_encode(reg, EV_CHTYPE, GSI_CHANNEL_TYPE_RTK) |
+		reg_encode(reg, EV_ELEMENT_SIZE, GSI_RTK_ELEMENT_SIZE);
+	/* EV_INTYPE = 0: MSI straight to the RTL8125, no AP NAPI. */
+	gsi_rtk_write(gsi, EV_CH_E_CNTXT_0, ev, value);
+	gsi_rtk_write(gsi, EV_CH_E_CNTXT_1, ev, c->ring_size);
+	gsi_rtk_write(gsi, EV_CH_E_CNTXT_2, ev, lower_32_bits(c->ring_addr));
+	gsi_rtk_write(gsi, EV_CH_E_CNTXT_3, ev, upper_32_bits(c->ring_addr));
+	reg = gsi_reg(gsi, EV_CH_E_CNTXT_8);
+	value = c->toward_ipa ? 0 : reg_encode(reg, EV_MODT, 32) |
+		reg_encode(reg, EV_MODC, 128);
+	gsi_rtk_write(gsi, EV_CH_E_CNTXT_8, ev, value);
+	gsi_rtk_write(gsi, EV_CH_E_CNTXT_9, ev, 0);
+	gsi_rtk_write(gsi, EV_CH_E_CNTXT_10, ev, lower_32_bits(msi));
+	gsi_rtk_write(gsi, EV_CH_E_CNTXT_11, ev, upper_32_bits(msi));
+	gsi_rtk_write(gsi, EV_CH_E_CNTXT_12, ev, 0);
+	gsi_rtk_write(gsi, EV_CH_E_CNTXT_13, ev, 0);
+	gsi_rtk_write(gsi, EV_CH_E_SCRATCH_0, ev, 0);
+	gsi_rtk_write(gsi, EV_CH_E_SCRATCH_1, ev, 0);
+
+	reg = gsi_reg(gsi, CH_C_CNTXT_0);
+	value = reg_encode(reg, CHTYPE_PROTOCOL, GSI_CHANNEL_TYPE_RTK) |
+		reg_encode(reg, ELEMENT_SIZE, GSI_RTK_ELEMENT_SIZE);
+	if (c->toward_ipa)
+		value |= reg_bit(reg, CHTYPE_DIR);
+	gsi_rtk_write(gsi, CH_C_CNTXT_0, ch, value);
+	reg = gsi_reg(gsi, CH_C_CNTXT_1);
+	value = reg_encode(reg, CH_R_LENGTH, c->ring_size) |
+		reg_encode(reg, CH_ERINDEX, ev);
+	gsi_rtk_write(gsi, CH_C_CNTXT_1, ch, value);
+	gsi_rtk_write(gsi, CH_C_CNTXT_2, ch, lower_32_bits(c->ring_addr));
+	gsi_rtk_write(gsi, CH_C_CNTXT_3, ch, upper_32_bits(c->ring_addr));
+	reg = gsi_reg(gsi, CH_C_QOS);
+	value = reg_encode(reg, WRR_WEIGHT, 1) | reg_bit(reg, USE_DB_ENG) |
+		reg_bit(reg, DB_IN_BYTES) |
+		reg_encode(reg, PREFETCH_MODE, SMART_PREFETCH) |
+		reg_encode(reg, EMPTY_LVL_THRSHOLD, 3);
+	gsi_rtk_write(gsi, CH_C_QOS, ch, value);
+	queue = c->toward_ipa ? c->queue : (c->queue ? 18 : 16);
+	gsi_rtk_write(gsi, CH_C_SCRATCH_0, ch, lower_32_bits(bar));
+	value = upper_32_bits(bar) | (queue << 9) |
+		(ilog2(c->buffer_size) << 14) |
+		(upper_32_bits(c->buffer_addr) << 24);
+	gsi_rtk_write(gsi, CH_C_SCRATCH_1, ch, value);
+	gsi_rtk_write(gsi, CH_C_SCRATCH_2, ch, lower_32_bits(c->buffer_addr));
+	gsi_rtk_write(gsi, CH_C_SCRATCH_3, ch, 0);
+	/* No DMA starts here; endpoint/uC and NIC setup still precede START. */
+	gsi_rtk_write(gsi, EV_CH_E_DOORBELL_0, ev,
+		      lower_32_bits(c->ring_addr) + c->ring_size + 32);
+	if (!c->toward_ipa)
+		gsi_rtk_write(gsi, CH_C_CNTXT_8, ch, 0xfdb);
+}
+
+int gsi_rtk_prepare(struct gsi *gsi, const struct gsi_rtk_config *c,
+		    struct gsi_rtk *rtk)
+{
+	struct resource *res;
+	struct gsi_channel *channel;
+	u32 ch;
+	int ev, ret;
+
+	if (!gsi || !c || !rtk || rtk->gsi)
+		return -EINVAL;
+	ret = gsi_rtk_validate(gsi, c);
+	if (ret)
+		return ret;
+	ch = c->toward_ipa ? 18 : 21;
+	if (ch >= gsi->channel_count)
+		return -ENODEV;
+	res = platform_get_resource_byname(to_platform_device(gsi->dev),
+					   IORESOURCE_MEM, "gsi");
+	if (!res || reg_n_offset(gsi_reg(gsi, CH_C_CNTXT_8), ch) + 4 >
+	    resource_size(res))
+		return -ENODEV;
+
+	mutex_lock(&gsi->mutex);
+	channel = &gsi->channel[ch];
+	if (channel->gsi) {
+		ret = -EBUSY;
+		goto out;
+	}
+	ev = gsi_evt_ring_id_alloc(gsi);
+	if (ev < 0) {
+		ret = ev;
+		goto out;
+	}
+	if (ev >= gsi->evt_ring_count) {
+		gsi_evt_ring_id_free(gsi, ev);
+		ret = -ENOSPC;
+		goto out;
+	}
+	/* Claim before the first command; failed commands can still own DMA. */
+	channel->gsi = gsi;
+	channel->rtk = rtk;
+	channel->toward_ipa = c->toward_ipa;
+	channel->evt_ring_id = ev;
+	rtk->gsi = gsi;
+	rtk->channel_id = ch;
+	rtk->event_id = ev;
+	rtk->msi_addr = res->start +
+		reg_n_offset(gsi_reg(gsi, CH_C_CNTXT_8), ch);
+	ret = gsi_evt_ring_alloc_command(gsi, ev);
+	if (ret)
+		goto out;
+	ret = gsi_channel_alloc_command(gsi, ch);
+	if (!ret) {
+		gsi_rtk_program(rtk, c);
+		rtk->prepared = true;
+		gsi_irq_msi_set(gsi, ev, true);
+	}
+out:
+	mutex_unlock(&gsi->mutex);
+	return ret;
+}
+
+int gsi_rtk_start(struct gsi_rtk *rtk)
+{
+	struct gsi *gsi;
+	int ret;
+
+	if (!rtk || !rtk->gsi || !rtk->prepared)
+		return -EINVAL;
+	gsi = rtk->gsi;
+	mutex_lock(&gsi->mutex);
+	if (gsi->channel[rtk->channel_id].rtk != rtk)
+		ret = -EINVAL;
+	else
+		ret = gsi_channel_start_command(&gsi->channel[rtk->channel_id]);
+	mutex_unlock(&gsi->mutex);
+	return ret;
+}
+
+int gsi_rtk_stop(struct gsi_rtk *rtk)
+{
+	struct gsi_channel *channel;
+	struct gsi *gsi;
+	enum gsi_channel_state state;
+	int ret = 0;
+
+	if (!rtk || !rtk->gsi)
+		return 0;
+	gsi = rtk->gsi;
+	channel = &gsi->channel[rtk->channel_id];
+	mutex_lock(&gsi->mutex);
+	if (channel->rtk != rtk) {
+		ret = -EINVAL;
+		goto out;
+	}
+	state = gsi_channel_state(channel);
+	if (state == GSI_CHANNEL_STATE_STARTED ||
+	    state == GSI_CHANNEL_STATE_STOP_IN_PROC)
+		ret = gsi_channel_stop_retry(channel);
+	else if (state != GSI_CHANNEL_STATE_ALLOCATED &&
+		 state != GSI_CHANNEL_STATE_STOPPED &&
+		 state != GSI_CHANNEL_STATE_NOT_ALLOCATED)
+		ret = -EIO;
+out:
+	mutex_unlock(&gsi->mutex);
+	return ret;
+}
+
+int gsi_rtk_release(struct gsi_rtk *rtk)
+{
+	struct gsi_channel *channel;
+	struct gsi *gsi;
+	enum gsi_channel_state state;
+	enum gsi_evt_ring_state ev_state;
+	int ret = -EBUSY;
+
+	if (!rtk || !rtk->gsi)
+		return 0;
+	gsi = rtk->gsi;
+	channel = &gsi->channel[rtk->channel_id];
+	mutex_lock(&gsi->mutex);
+	if (channel->rtk != rtk) {
+		ret = -EINVAL;
+		goto out;
+	}
+	state = gsi_channel_state(channel);
+	if (state == GSI_CHANNEL_STATE_STARTED ||
+	    state == GSI_CHANNEL_STATE_STOP_IN_PROC)
+		goto out;
+	gsi_irq_msi_set(gsi, rtk->event_id, false);
+	rtk->prepared = false;
+	if (state == GSI_CHANNEL_STATE_STOPPED || state == GSI_CHANNEL_STATE_ERROR)
+		gsi_channel_reset_command(channel);
+	state = gsi_channel_state(channel);
+	if (state == GSI_CHANNEL_STATE_ALLOCATED)
+		gsi_channel_de_alloc_command(gsi, rtk->channel_id);
+	if (gsi_channel_state(channel) != GSI_CHANNEL_STATE_NOT_ALLOCATED)
+		goto out;
+	ev_state = gsi_evt_ring_state(gsi, rtk->event_id);
+	if (ev_state != GSI_EVT_RING_STATE_NOT_ALLOCATED) {
+		gsi_evt_ring_reset_command(gsi, rtk->event_id);
+		if (gsi_evt_ring_state(gsi, rtk->event_id) ==
+		    GSI_EVT_RING_STATE_ALLOCATED)
+			gsi_evt_ring_de_alloc_command(gsi, rtk->event_id);
+	}
+	if (gsi_evt_ring_state(gsi, rtk->event_id) !=
+	    GSI_EVT_RING_STATE_NOT_ALLOCATED)
+		goto out;
+	gsi_evt_ring_id_free(gsi, rtk->event_id);
+	memset(channel, 0, sizeof(*channel));
+	memset(rtk, 0, sizeof(*rtk));
+	ret = 0;
+out:
+	mutex_unlock(&gsi->mutex);
+	return ret;
+}
