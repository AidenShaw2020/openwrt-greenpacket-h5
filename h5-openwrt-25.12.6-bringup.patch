+include $(TOPDIR)/rules.mk
+
+LUCI_TITLE:=GreenPacket H5 radio measurements and cell locking
+LUCI_DEPENDS:=+h5-modem-tools
+LUCI_PKGARCH:=all
+PKG_LICENSE:=GPL-2.0-only
+
+include $(TOPDIR)/feeds/luci/luci.mk
