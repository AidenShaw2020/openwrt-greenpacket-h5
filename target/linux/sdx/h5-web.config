# Seed for a clean vanilla OpenWrt v25.12.6 checkout; run make defconfig.
CONFIG_TARGET_sdx=y
CONFIG_TARGET_sdx_generic=y
CONFIG_TARGET_sdx_generic_DEVICE_greenpacket_h5-200q1-web=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
# CONFIG_TARGET_INITRAMFS_COMPRESSION_GZIP is not set
CONFIG_TARGET_INITRAMFS_COMPRESSION_XZ=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_uhttpd-mod-ucode=y
CONFIG_PACKAGE_kmod-gpio-button-hotplug=y
