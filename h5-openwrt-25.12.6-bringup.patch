diff --git a/target/linux/sdx/files-6.12/arch/arm/boot/dts/qcom/qcom-sdx65-greenpacket-h5-cpe.dts b/target/linux/sdx/files-6.12/arch/arm/boot/dts/qcom/qcom-sdx65-greenpacket-h5-cpe.dts
new file mode 100644
--- /dev/null
+++ b/target/linux/sdx/files-6.12/arch/arm/boot/dts/qcom/qcom-sdx65-greenpacket-h5-cpe.dts
@@ -0,0 +1,34 @@
+// SPDX-License-Identifier: BSD-3-Clause
+#include "qcom-sdx65-greenpacket-h5-ipa.dts"
+
+/ {
+	/* Keep the first compatible stable for normal OpenWrt board detection. */
+	compatible = "greenpacket,h5-200q1", "greenpacket,h5-200q1-openwrt", "qcom,sdx65";
+
+	chosen {
+		bootargs = "console=ttyMSM0,115200n8 loglevel=7 pcie_ports=compat pci=pcie_bus_safe";
+	};
+};
+
+&{/soc/sram@1468f000} {
+	reboot-mode {
+		compatible = "syscon-reboot-mode";
+		offset = <0x65c>;
+		/* Verified against this H5's original restart driver. */
+		mode-normal = <0x77665501>;
+		mode-bootloader = <0x77665500>;
+		mode-recovery = <0x77665502>;
+	};
+};
+
+/* Match this board's original SCM download-mode register at 0x01fd3000.
+ * The upstream SCM driver clears it on orderly shutdown. Without the DT
+ * address it may leave an inherited download-mode request untouched.
+ */
+&{/firmware/scm} {
+	qcom,dload-mode = <&tcsr 0x13000>;
+};
+
+&tcsr {
+	reg = <0x01fc0000 0x30000>;
+};
diff --git a/target/linux/sdx/files-6.12/arch/arm/boot/dts/qcom/qcom-sdx65-greenpacket-h5-ipa.dts b/target/linux/sdx/files-6.12/arch/arm/boot/dts/qcom/qcom-sdx65-greenpacket-h5-ipa.dts
new file mode 100644
--- /dev/null
+++ b/target/linux/sdx/files-6.12/arch/arm/boot/dts/qcom/qcom-sdx65-greenpacket-h5-ipa.dts
@@ -0,0 +1,32 @@
+// SPDX-License-Identifier: BSD-3-Clause
+#include "qcom-sdx65-greenpacket-h5-modem.dts"
+
+&ipa {
+	/* Stock boot firmware already enables GSI; do not load it a second time. */
+	qcom,gsi-loader = "skip";
+	interrupts-extended = <&intc GIC_SPI 241 IRQ_TYPE_LEVEL_HIGH>,
+			      <&intc GIC_SPI 47 IRQ_TYPE_LEVEL_HIGH>,
+			      <&ipa_smp2p_in 0 IRQ_TYPE_EDGE_RISING>,
+			      <&ipa_smp2p_in 1 IRQ_TYPE_EDGE_RISING>;
+	memory-region = <&ipa_fw_mem>;
+	status = "okay";
+};
+
+&qpic_bam {
+	status = "okay";
+};
+
+&qpic_nand {
+	status = "okay";
+
+	nand@0 {
+		reg = <0>;
+		nand-ecc-strength = <4>;
+		nand-ecc-step-size = <512>;
+		nand-bus-width = <8>;
+		/* Exact efs2 range from the verified H5 MIBIB backup. Access is
+		 * blocked by the NAND core before any hardware read is issued.
+		 */
+		secure-regions = /bits/ 64 <0x380000 0x1600000>;
+	};
+};
diff --git a/target/linux/sdx/files-6.12/arch/arm/boot/dts/qcom/qcom-sdx65-greenpacket-h5-modem.dts b/target/linux/sdx/files-6.12/arch/arm/boot/dts/qcom/qcom-sdx65-greenpacket-h5-modem.dts
