+	resp.resp.result = QMI_RESULT_FAILURE_V01;
+	resp.resp.error = QMI_ERR_MALFORMED_MSG_V01;
+	if (!of_machine_is_compatible("greenpacket,h5-200q1")) {
+		resp.resp.error = QMI_ERR_NOT_SUPPORTED_V01;
+		goto reply;
+	}
+	if (!ipa_qmi_rtk_request_valid(req))
+		goto reply;
+	copy = kmemdup(req, sizeof(*req), GFP_KERNEL);
+	if (!copy) {
+		resp.resp.error = QMI_ERR_NO_MEMORY_V01;
+		goto reply;
+	}
+	mutex_lock(&ipa_rtk_qmi_lock);
+	if (ipa_rtk_qmi_owner && ipa_rtk_qmi_owner != ipa) {
+		mutex_unlock(&ipa_rtk_qmi_lock);
