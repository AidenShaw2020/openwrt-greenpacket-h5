diff --git a/package/kernel/h5-ipa-rtk/src/ipa_table_rtk.h b/package/kernel/h5-ipa-rtk/src/ipa_table_rtk.h
new file mode 100644
index 00000000..c5590d0e
--- /dev/null
+++ b/package/kernel/h5-ipa-rtk/src/ipa_table_rtk.h
@@ -0,0 +1,62 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _IPA_TABLE_RTK_H_
+#define _IPA_TABLE_RTK_H_
+#include <linux/dma-mapping.h>
+#include <linux/list.h>
+struct ipa;
+
+#define IPA_RTK_HEADER_CAPACITY 200
+/* Dedicated system processing contexts. The global base must be unused; the
+ * lease never follows, replaces, or frees modem-owned system memory.
+ */
+struct ipa_rtk_header_bank {
+	struct ipa *ipa;
+	void *buffer;
+	dma_addr_t address;
+};
+int ipa_header_rtk_bank_acquire(struct ipa *ipa, struct ipa_rtk_header_bank *bank);
+int ipa_header_rtk_bank_set(struct ipa_rtk_header_bank *bank, unsigned int slot,
+			    const u8 ethernet[14]);
+int ipa_header_rtk_bank_release(struct ipa_rtk_header_bank *bank);
+
+struct ipa_rtk_table {
+	struct list_head node;
+	struct ipa *ipa;
+	u32 offset;
+	u64 original_pointer;
+	bool installed;
+	u64 installed_pointer;
+	u32 base_offset;
+	bool modem;
+};
+
+/* A 16-byte local AP header slot. Routes reference route_offset, relative to
+ * the complete modem+AP local header table, not the raw SRAM offset.
+ */
+struct ipa_rtk_header {
+	struct list_head node;
+	struct ipa *ipa;
+	u32 offset;
+	u16 route_offset;
+	u8 original[16];
+};
+
+/* Handles must be zero-initialized and remain alive until release succeeds.
+ * Caller holds IPA power and retains rule DMA until successful replacement
+ * or release. Release restores the exact original, possibly local, pointer.
+ */
+int ipa_table_rtk_acquire(struct ipa *ipa, bool filter, bool ipv6,
+			  u32 id, struct ipa_rtk_table *table);
+int ipa_table_rtk_acquire_hashed(struct ipa *ipa, bool filter, bool ipv6,
+				 u32 id, struct ipa_rtk_table *table);
+/* Non-hashed IPv4 modem downlink only. Preserve its original rule bytes and
+ * leave its hashed table untouched. Concurrent modem replacement is ESTALE.
+ */
+int ipa_table_rtk_acquire_downlink(struct ipa *ipa, struct ipa_rtk_table *table);
+int ipa_table_rtk_copy_local(struct ipa_rtk_table *table, void *buffer, size_t capacity);
+int ipa_table_rtk_replace(struct ipa_rtk_table *table, dma_addr_t rule_address);
+int ipa_table_rtk_release(struct ipa_rtk_table *table);
+int ipa_header_rtk_acquire(struct ipa *ipa, const u8 ethernet[14],
+			   struct ipa_rtk_header *header);
+int ipa_header_rtk_release(struct ipa_rtk_header *header);
+#endif
diff --git a/package/kernel/h5-ipa-rtk/src/ipa_uc_rtk.h b/package/kernel/h5-ipa-rtk/src/ipa_uc_rtk.h
new file mode 100644
index 00000000..9316c205
--- /dev/null
+++ b/package/kernel/h5-ipa-rtk/src/ipa_uc_rtk.h
@@ -0,0 +1,37 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _IPA_UC_RTK_H_
+#define _IPA_UC_RTK_H_
+
+#include <linux/dma-mapping.h>
+#include <linux/types.h>
+
+struct ipa;
+
+/* Exact H5 stock ipa3_eth_config_uc ABI: setup 28 bytes, teardown 8 bytes. */
+struct ipa_uc_rtk_setup {
+	__le32 protocol;		/* 9: RTK */
+	u8 direction;		/* 0: Ethernet RX, 1: Ethernet TX */
+	u8 gsi_channel;
+	__le16 reserved;
+	u8 padding[20];
+} __packed;
+
+struct ipa_uc_rtk_teardown {
+	__le32 protocol;
+	u8 gsi_channel;
+	u8 reserved[3];
+} __packed;
+
+/*
+ * Address is a coherent DMA allocation through ipa->dev.  On SDX65 this
+ * device maps both AP SID 0x5e0 and UC SID 0x5e2 into the same IOMMU domain.
+ * The caller fills the appropriate zero-padded structure and holds a runtime
+ * power reference covering the entire external-ring lifetime.
+ *
+ * -ETIMEDOUT/-EPROTO: completion is unknown; retain payload and ring mappings
+ * until hardware reset. Further commands are refused. Do not attempt fallback
+ * by freeing memory still owned by the microcontroller.
+ */
+int ipa_uc_rtk_command(struct ipa *ipa, dma_addr_t address, bool setup);
+
+#endif
diff --git a/package/kernel/h5-ipa-rtk/src/r8125/r8125_lib.h b/package/kernel/h5-ipa-rtk/src/r8125/r8125_lib.h
new file mode 100644
index 00000000..c222b085
--- /dev/null
+++ b/package/kernel/h5-ipa-rtk/src/r8125/r8125_lib.h
@@ -0,0 +1,181 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef _LINUX_rtl8125_LIB_H
+#define _LINUX_rtl8125_LIB_H
+
+/*
+IPA SW would like to pass its own memory allocators to
+request_ring() to allocate/free the memory for the descriptor ring and buffers.
+
+Private field is needed in allocator.
+Private field will be used by IPA offload software, not to be touched by
+Realtek driver.
+
+Realtek driver can use the allocators similar to dma_alloc_coherent() and
+dma_free_coherent(). Allocator should pass the mem ops as one of the parameters
+for us to access our private data.
+*/
+
+#include <linux/device.h>
+#include <linux/types.h>
+
+struct rtl8125_private;
+
+struct rtl8125_mem_ops {
+        void *(*alloc_descs)(struct device *dev, size_t size, dma_addr_t *daddr,
+                             gfp_t gfp, struct rtl8125_mem_ops *ops);
+        void *(*alloc_buf)(struct device *dev, size_t size, dma_addr_t *daddr,
+                           gfp_t gfp, struct rtl8125_mem_ops *ops);
+
+        void (*free_descs)(void *buf, struct device *dev, size_t size,
+                           dma_addr_t daddr, struct rtl8125_mem_ops *ops);
+        void (*free_buf)(void *buf, struct device *dev, size_t size,
+                         dma_addr_t daddr, struct rtl8125_mem_ops *ops);
+
+        void *private;
+};
+
+enum rtl8125_channel_dir {
+        RTL8125_CH_DIR_RX,
+        RTL8125_CH_DIR_TX,
+};
+
+enum rtl8125_ring_flags {
+        RTL8125_CONTIG_BUFS = BIT(0), /* Alloc entire ring buffer memory as a contiguous block */
+        RTL8125_NO_CLOSE = BIT(1), /* No Close Feature */
+        /*...*/
+};
+
+/* Represents each buffer allocated */
+struct rtl8125_buf {
+        /* struct list_head bufs_list; */
+        void *addr;
+        dma_addr_t dma_addr;
+        phys_addr_t phys_addr;
+        size_t size;
+};
+
+enum rtl8125_event_flags {
+        /* If any */
+        MSIX_event_type = BIT(0),
+};
+
+struct rtl8125_event {
+        /* MSI vector information as needed */
+        dma_addr_t addr;
+        u64 data;
+        bool allocated;
+        bool enabled;
+        u32 message_id;
+
+        /* Moderation parameters */
+        int delay;
+};
+
+/* Represents ring allocated for IPA */
+struct rtl8125_ring {
+        bool enabled;
+        bool allocated;
+        enum rtl8125_channel_dir direction;
+
+        u32 queue_num;
+        unsigned long flags;
+
+        unsigned ring_size;
+        unsigned desc_size;
+        unsigned buff_size;
+
+        void *desc_addr; /* descriptor base virt addr */
+        dma_addr_t desc_daddr; /* descriptor base dma addr */
+        phys_addr_t desc_paddr; /* descriptor base phys addr */
+
+        /* List or array of buffers allocated. If RTL8125_CONTIG_BUFS was
+          requested, then only one entry need to be populated for the one
+          contiguous buffer.
+         */
+        struct rtl8125_buf *bufs; /* OR struct list_head bufs; */
+
+        struct rtl8125_mem_ops *mem_ops; /* store mem ops to use for freeing */
+
+        /* Other driver fields */
+        struct rtl8125_event event;
+
+        void *private;
+};
+
+struct rtl8125_counters;
+struct rtl8125_regs_save;
+
+enum rtl8125_rss_flags {
+        RTL8125_RSS_HASH_IPV4 = BIT(0),
+        RTL8125_RSS_HASH_IPV6 = BIT(1),
+        /*...*/
+};
+
+enum rtl8125_notify {
+        RTL8125_NOTIFY_RESET_PREPARE,
+        RTL8125_NOTIFY_RESET_COMPLETE,
+};
+
+/* Allocate an Rx or Tx ring */
+struct rtl8125_ring *rtl8125_request_ring(struct net_device *ndev,
+                unsigned int ring_size, unsigned int buff_size,
+                enum rtl8125_channel_dir direction, unsigned int flags,
+                struct rtl8125_mem_ops *mem_ops);
+
+void rtl8125_release_ring(struct rtl8125_ring *ring);
+
+/* Starts the ring */
+int rtl8125_enable_ring(struct rtl8125_ring *ring);
+
+void rtl8125_disable_ring(struct rtl8125_ring *ring);
+
+
+/* Allocate an event (MSI-X, pointer wrb, etc.). Only one type of event will
+be requested from a ring at any point of time.
+*/
+int rtl8125_request_event(struct rtl8125_ring *ring, unsigned long flags,
+                          dma_addr_t addr, u64 data);
+
+void rtl8125_release_event(struct rtl8125_ring *ring);
+
+/* Enables the interrupt */
+int rtl8125_enable_event(struct rtl8125_ring *ring);
+
+int rtl8125_disable_event(struct rtl8125_ring *ring);
+
+
+/* Sets interrupt moderation. Count, Timer, or both. If HW does not suport
+ranges for moderation, one parameter for timer and count is sufficient.*/
+int rtl8125_set_ring_intr_mod(struct rtl8125_ring *ring, int delay);
+
+/* Redirect Rx RSS hash table to a given ring */
+int rtl8125_rss_redirect(struct net_device *ndev,
+                         unsigned long flags,
+                         struct rtl8125_ring *ring);
+
+/* Reset RSS hash table to driver default. IPA will call this only after Rx ring
+ is disabled through disable_ring() API.
+*/
+int rtl8125_rss_reset(struct net_device *ndev);
+
+/* Get net_device object from struct device. */
+struct net_device *rtl8125_get_netdev(struct device *dev);
+
+int rtl8125_receive_skb(struct net_device *net_dev, struct sk_buff *skb,
+                        bool napi);
+
+int rtl8125_register_notifier(struct net_device *net_dev,
+                              struct notifier_block *nb);
+
+int rtl8125_unregister_notifier(struct net_device *net_dev,
+                                struct notifier_block *nb);
+
+void rtl8125_lib_reset_prepare(struct rtl8125_private *tp);
+
+void rtl8125_lib_reset_complete(struct rtl8125_private *tp);
+
+int rtl8125_lib_get_stats(struct net_device *ndev, struct rtl8125_counters *stats);
+
+int rtl8125_lib_save_regs(struct net_device *ndev, struct rtl8125_regs_save *stats);
+
+#endif /* _LINUX_rtl8125_LIB_H */
