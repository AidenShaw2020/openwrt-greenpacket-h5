diff --git a/target/linux/sdx/h5-cpe.config b/target/linux/sdx/h5-cpe.config
new file mode 100644
index 00000000..9aa5f54a
--- /dev/null
+++ b/target/linux/sdx/h5-cpe.config
@@ -0,0 +1,29 @@
+CONFIG_TARGET_sdx=y
+CONFIG_TARGET_sdx_generic=y
+CONFIG_TARGET_sdx_generic_DEVICE_greenpacket_h5-200q1-cpe=y
+CONFIG_KERNEL_BUILD_USER="builder"
+CONFIG_KERNEL_BUILD_DOMAIN="buildhost"
+CONFIG_TARGET_ROOTFS_INITRAMFS=y
+CONFIG_TARGET_INITRAMFS_COMPRESSION_XZ=y
+CONFIG_TARGET_ROOTFS_SQUASHFS=y
+CONFIG_PACKAGE_luci=y
+CONFIG_PACKAGE_uhttpd-mod-ucode=y
+CONFIG_PACKAGE_modemmanager=y
+CONFIG_PACKAGE_modemmanager-rpcd=y
+CONFIG_PACKAGE_luci-proto-modemmanager=y
+CONFIG_PACKAGE_luci-app-h5-modem=y
+CONFIG_MODEMMANAGER_WITH_NETIFD=y
+CONFIG_MODEMMANAGER_WITH_QMI=y
+CONFIG_MODEMMANAGER_WITH_QRTR=y
+# CONFIG_MODEMMANAGER_WITH_MBIM is not set
