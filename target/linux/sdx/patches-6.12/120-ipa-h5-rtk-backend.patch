+static u64 ipa_rtk_table_pointer(const struct ipa_rtk_table *table)
+{
+	__le64 pointer;
+	memcpy_fromio(&pointer, table->ipa->mem_virt + table->ipa->mem_offset +
+		      table->offset, sizeof(pointer));
+	return le64_to_cpu(pointer);
+}
+
+/* A modem update must not be overwritten while releasing an older handle.
+ * Drain previous readers/cache entries without writing the pointer slot.
+ */
+static int ipa_rtk_table_drain(struct ipa *ipa)
+{
+	struct gsi_trans *trans = ipa_cmd_trans_alloc(ipa, 2);
+	const struct reg *reg = ipa_reg(ipa, FILT_ROUT_CACHE_FLUSH);
+	u32 flush = reg_bit(reg, ROUTER_CACHE) | reg_bit(reg, FILTER_CACHE);
+	if (!trans)
+		return -EBUSY;
+	ipa_cmd_register_write_add(trans, 0, 0, 0, true);
+	ipa_cmd_register_write_add(trans, reg_offset(reg), flush, flush, false);
+	gsi_trans_commit_wait(trans);
+	return 0;
+}
+
+static int ipa_rtk_table_write(struct ipa_rtk_table *table, u64 encoded_pointer)
+{
+	struct ipa *ipa = table->ipa;
+	struct gsi_trans *trans;
+	const struct reg *reg;
+	dma_addr_t address;
+	__le64 *pointer;
+	u32 flush;
+	pointer = dma_alloc_coherent(ipa->dev, sizeof(*pointer), &address, GFP_KERNEL);
+	if (!pointer)
+		return -ENOMEM;
+	*pointer = cpu_to_le64(encoded_pointer);
+	trans = ipa_cmd_trans_alloc(ipa, 3);
+	if (!trans) {
+		dma_free_coherent(ipa->dev, sizeof(*pointer), pointer, address);
+		return -EBUSY;
+	}
+	ipa_cmd_register_write_add(trans, 0, 0, 0, true);
+	ipa_cmd_dma_shared_mem_add(trans, table->offset, sizeof(*pointer), address, true);
+	reg = ipa_reg(ipa, FILT_ROUT_CACHE_FLUSH);
+	flush = reg_bit(reg, ROUTER_CACHE) | reg_bit(reg, FILTER_CACHE);
+	ipa_cmd_register_write_add(trans, reg_offset(reg), flush, flush, false);
+	dma_wmb();
+	gsi_trans_commit_wait(trans);
+	dma_free_coherent(ipa->dev, sizeof(*pointer), pointer, address);
+	return 0;
+}
