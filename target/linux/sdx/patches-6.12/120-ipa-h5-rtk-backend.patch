+	if (!ipa || !notification || notification->source_pipe_index != 8 ||
+	    notification->filter_index_list_len > 64 || notification->rule_id_len > 64 ||
+	    notification->rule_id_ex_len > 256 || notification->dst_pipe_id_len > 8)
+		return -EINVAL;
+	if (!READ_ONCE(ipa->qmi.modem_ready) || !READ_ONCE(ipa->qmi.uc_ready) ||
+	    READ_ONCE(ipa->qmi.initial_boot))
+		return -ENODEV;
+	mutex_lock(&ipa_rtk_qmi_lock);
+	generation_matches = ipa_rtk_qmi_owner == ipa && ipa_rtk_qmi_rules &&
+		  ipa_rtk_qmi_generation == generation;
+	mutex_unlock(&ipa_rtk_qmi_lock);
+	if (!generation_matches)
+		return -ESTALE;
+	handle = &ipa->qmi.client_handle;
+	ret = qmi_txn_init(handle, &txn, h5_fltr_installed_notif_resp_msg_ei, &response);
